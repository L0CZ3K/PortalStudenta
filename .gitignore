# ==============================================================================
# UniAvio (Portal Studenta) - Production .gitignore (.NET 10 MAUI & Blazor Hybrid)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CRITICAL: Security & Leak Prevention (Klucze, Tokeny, Certyfikaty)
# ------------------------------------------------------------------------------
# Lokalne klucze API i sekrety (USOS, serwery, testowe dane)
*Secrets.Local.cs
UsosSecrets.Local.cs
*.local.cs
*.local.json
appsettings.*.local.json
appsettings.local.json
secrets.json
.env
.env.*
*.env

# Certyfikaty, klucze prywatne i keystore (Android / iOS / Mac)
*.pfx
*.p12
*.pem
*.key
*.cer
*.crt
*.p8
*.mobileprovision
*.keystore
*.jks

# Klucze chmurowe i service accounts (Firebase / GCP / Azure)
service-account*.json
firebase-adminsdk*.json
*client_secret*.json

# ------------------------------------------------------------------------------
# 2. Lokalne bazy danych, pamięć podręczna i załączniki użytkownika
# ------------------------------------------------------------------------------
# Bazy SQLite
*.db3
*.db3-shm
*.db3-wal
*.db
*.db-journal
*.sqlite
*.sqlite3

# Pamięć podręczna harmonogramu i modyfikacji
usos_schedule_cache.json
schedule_modifications.json
custom_events_cache.json

# Lokalne pliki załączników i zdjęć tablicy
notes_attachments/
*notes_attachments*/

# ------------------------------------------------------------------------------
# 3. Pliki robocze, zrzuty kontekstu i logi
# ------------------------------------------------------------------------------
context*.txt
*_context.txt
auth.txt
build_output.txt
*.dump
scratch/
*.log

