# ==============================================================================
# UniAvio (Portal Studenta) - Git Attributes (.NET 10 MAUI & Blazor Hybrid)
# ==============================================================================

# Set default behavior: normalize all text files to LF on checkout/commit
* text=auto eol=lf

# Explicit text file formats with specific diff drivers
*.cs                text diff=csharp
*.razor             text
*.xaml              text
*.xml               text
*.csproj            text
*.slnx              text
*.sln               text eol=crlf
*.props             text
*.targets           text
*.json              text
*.css               text
*.js                text
*.html              text
*.md                text
*.plist             text
*.resx              text
*.Designer.cs       text
*.xcprivacy         text
*.http              text

# Binary assets (prevent corrupting or normalizing binaries)
*.png               binary
*.jpg               binary
*.jpeg              binary
*.webp              binary
*.gif               binary
*.ico               binary
*.ttf               binary
*.otf               binary
*.woff              binary
*.woff2             binary
*.pdf               binary
*.jar               binary
*.aar               binary
*.dll               binary
*.dylib             binary
*.so                binary
*.a                 binary
*.app               binary
*.svg               text
