@using Portal_Studenta.Models
@using Portal_Studenta.Services
@inject AppState AppState
@inject NoteService NoteService
@inject ScheduleService ScheduleService
@inject AnnouncementService AnnouncementService
@inject NavigationManager Navigation

@if (IsOpen)
{
    <div class="global-search-backdrop" @onclick="Close" @onkeydown="HandleKeyDown">
        <div class="global-search-dialog" @onclick:stopPropagation="true">
            <div class="global-search-header">
                <span class="global-search-icon">🔍</span>
                <input type="text"
                       class="global-search-input"
                       placeholder="@AppState.T("Szukaj notatek, zajęć, prowadzących, sal, ogłoszeń...", "Search notes, classes, lecturers, rooms, announcements...")"
                       @bind="searchQuery"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown"
                       autofocus />
                @if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <button type="button" class="global-search-clear-btn" @onclick="ClearSearch">✕</button>
                }
                <button type="button" class="global-search-esc-badge" @onclick="Close">ESC</button>
            </div>

            <div class="global-search-body">
                @if (string.IsNullOrWhiteSpace(searchQuery))
                {
                    <div class="global-search-empty">
                        <div style="font-size: 2rem; margin-bottom: 8px;">⚡</div>
                        <div style="font-weight: 700; color: var(--text-main);">
                            @AppState.T("Globalna wyszukiwarka UniAvio", "UniAvio Global Search")
                        </div>
                        <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">
                            @AppState.T("Wpisz frazę, aby przeszukać wszystkie notatki, przedmioty, sale wykładowe, prowadzących oraz ogłoszenia.", "Type to search across all notes, subjects, classrooms, lecturers, and announcements.")
                        </div>
                    </div>
                }
                else if (!MatchedNotes.Any() && !MatchedLessons.Any() && !MatchedAnnouncements.Any())
                {
                    <div class="global-search-empty">
                        <div style="font-size: 2rem; margin-bottom: 8px;">🔎</div>
                        <div style="font-weight: 600; color: var(--text-main);">
                            @AppState.T("Brak wyników dla:", "No results for:") „@searchQuery”
                        </div>
                    </div>
                }
                else
                {
                    @if (MatchedNotes.Any())
                    {
                        <div class="global-search-section">
                            <div class="global-search-section-title">
                                📝 @AppState.T("Notatki", "Notes") (@MatchedNotes.Count)
                            </div>
                            @foreach (var note in MatchedNotes)
                            {
                                <button type="button" class="global-search-result-item" @onclick="() => OpenNote(note)">
                                    <div class="global-search-result-main">
                                        <span class="global-search-result-title">
                                            @(string.IsNullOrWhiteSpace(note.Title) ? AppState.T("Bez tytułu", "Untitled") : note.Title)
                                        </span>
                                        <span class="global-search-result-snippet">
                                            @GetNoteSnippet(note.Content)
                                        </span>
                                    </div>
                                    <div class="global-search-result-meta">
                                        @if (!string.IsNullOrWhiteSpace(note.Subject))
                                        {
                                            <span class="global-search-badge">@note.Subject</span>
                                        }
                                        <span class="global-search-date">@note.UpdatedAt.ToString("dd.MM")</span>
                                    </div>
                                </button>
                            }
                        </div>
                    }

                    @if (MatchedLessons.Any())
                    {
                        <div class="global-search-section">
                            <div class="global-search-section-title">
                                📅 @AppState.T("Plan Zajęć i Wydarzenia", "Schedule & Events") (@MatchedLessons.Count)
                            </div>
                            @foreach (var lesson in MatchedLessons)
                            {
                                <button type="button" class="global-search-result-item" @onclick="OpenSchedule">
                                    <div class="global-search-result-main">
                                        <span class="global-search-result-title">@lesson.Title</span>
                                        <span class="global-search-result-snippet">
                                            @(string.IsNullOrWhiteSpace(lesson.Person) ? "" : $"👤 {lesson.Person} • ")
                                            @(string.IsNullOrWhiteSpace(lesson.Place) ? "" : $"📍 {lesson.Place} • ")
                                            🕒 @lesson.Start.ToString("ddd dd.MM HH:mm")
                                        </span>
                                    </div>
                                    <div class="global-search-result-meta">
                                        @if (!string.IsNullOrWhiteSpace(lesson.Type))
                                        {
                                            <span class="global-search-badge">@lesson.Type</span>
                                        }
                                    </div>
                                </button>
                            }
                        </div>
                    }

                    @if (MatchedAnnouncements.Any())
                    {
                        <div class="global-search-section">
                            <div class="global-search-section-title">
                                📣 @AppState.T("Ogłoszenia", "Announcements") (@MatchedAnnouncements.Count)
                            </div>
                            @foreach (var ann in MatchedAnnouncements)
                            {
                                <button type="button" class="global-search-result-item" @onclick="OpenAnnouncements">
                                    <div class="global-search-result-main">
                                        <span class="global-search-result-title">@ann.Title</span>
                                        <span class="global-search-result-snippet">
                                            @(string.IsNullOrWhiteSpace(ann.ShortContent) ? ann.Content : ann.ShortContent)
                                        </span>
                                    </div>
                                    <div class="global-search-result-meta">
                                        <span class="global-search-badge">@ann.Author</span>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

<style>
    .global-search-backdrop {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(8, 12, 24, 0.65);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 10vh 16px 24px;
    }

    .global-search-dialog {
        width: 100%;
        max-width: 640px;
        background: var(--card-bg, #161c2e);
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 18px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        max-height: 76vh;
    }

    .global-search-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .global-search-icon {
        font-size: 1.15rem;
        opacity: 0.75;
    }

    .global-search-input {
        flex: 1;
        background: transparent;
        border: none;
        outline: none;
        color: var(--text-main, #f8fafc);
        font-size: 1rem;
        font-weight: 500;
    }

    .global-search-clear-btn {
        background: rgba(255, 255, 255, 0.08);
        border: none;
        color: var(--text-muted, #94a3b8);
        border-radius: 50%;
        width: 24px;
        height: 24px;
        font-size: 0.75rem;
        cursor: pointer;
    }

    .global-search-esc-badge {
        background: rgba(255, 255, 255, 0.07);
        border: 1px solid rgba(255, 255, 255, 0.14);
        color: var(--text-muted, #94a3b8);
        border-radius: 6px;
        padding: 3px 8px;
        font-size: 0.72rem;
        font-weight: 700;
        cursor: pointer;
    }

    .global-search-body {
        overflow-y: auto;
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .global-search-empty {
        text-align: center;
        padding: 32px 20px;
    }

    .global-search-section {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .global-search-section-title {
        font-size: 0.74rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted, #94a3b8);
        padding: 4px 8px;
    }

    .global-search-result-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        width: 100%;
        text-align: left;
        padding: 10px 12px;
        border-radius: 10px;
        border: 1px solid transparent;
        background: rgba(255, 255, 255, 0.025);
        color: var(--text-main, #f8fafc);
        cursor: pointer;
        transition: background 0.15s ease, border-color 0.15s ease;
    }

    .global-search-result-item:hover {
        background: rgba(59, 130, 246, 0.12);
        border-color: rgba(59, 130, 246, 0.35);
    }

    .global-search-result-main {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
        flex: 1;
    }

    .global-search-result-title {
        font-size: 0.92rem;
        font-weight: 650;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .global-search-result-snippet {
        font-size: 0.78rem;
        color: var(--text-muted, #94a3b8);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .global-search-result-meta {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
    }

    .global-search-badge {
        font-size: 0.7rem;
        font-weight: 600;
        padding: 2px 7px;
        border-radius: 6px;
        background: rgba(59, 130, 246, 0.16);
        color: #60a5fa;
        max-width: 130px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .global-search-date {
        font-size: 0.72rem;
        color: var(--text-muted, #94a3b8);
    }
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private string searchQuery = "";
    private List<AnnouncementItem> cachedAnnouncements = new();
    private bool announcementsLoaded = false;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !announcementsLoaded)
        {
            announcementsLoaded = true;
            try
            {
                await NoteService.EnsureInitializedAsync();
                cachedAnnouncements = await AnnouncementService.GetAnnouncementsAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[GlobalSearch] Announcement preload error: {ex.Message}");
            }
        }
    }

    private List<Note> MatchedNotes
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchQuery)) return new();
            var q = searchQuery.Trim();
            return NoteService.GetAllNotes()
                .Where(n =>
                    (n.Title != null && n.Title.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (n.Subject != null && n.Subject.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (n.Author != null && n.Author.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (n.Content != null && StripHtml(n.Content).Contains(q, StringComparison.OrdinalIgnoreCase)))
                .Take(8)
                .ToList();
        }
    }

    private List<Lesson> MatchedLessons
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchQuery)) return new();
            var q = searchQuery.Trim();
            return ScheduleService.GetAllEvents()
                .Where(l =>
                    !l.IsCanceled &&
                    ((l.Title != null && l.Title.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                     (l.Person != null && l.Person.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                     (l.Place != null && l.Place.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                     (l.Type != null && l.Type.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                     (l.Desc != null && l.Desc.Contains(q, StringComparison.OrdinalIgnoreCase))))
                .GroupBy(l => $"{l.Title}|{l.Type}|{l.Place}|{l.Person}")
                .Select(g => g.OrderBy(x => Math.Abs((x.Start - DateTime.Now).Ticks)).First())
                .Take(6)
                .ToList();
        }
    }

    private List<AnnouncementItem> MatchedAnnouncements
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchQuery)) return new();
            var q = searchQuery.Trim();
            return cachedAnnouncements
                .Where(a =>
                    (a.Title != null && a.Title.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (a.ShortContent != null && a.ShortContent.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (a.Content != null && a.Content.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (a.Author != null && a.Author.Contains(q, StringComparison.OrdinalIgnoreCase)))
                .Take(5)
                .ToList();
        }
    }

    private static string StripHtml(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return "";
        var noImg = System.Text.RegularExpressions.Regex.Replace(html, @"<img[^>]*>", " ", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        var plain = System.Text.RegularExpressions.Regex.Replace(noImg, "<.*?>", " ");
        return System.Net.WebUtility.HtmlDecode(plain).Trim();
    }

    private static string GetNoteSnippet(string? html)
    {
        var text = StripHtml(html);
        if (string.IsNullOrWhiteSpace(text)) return "—";
        return text.Length > 80 ? text.Substring(0, 80) + "…" : text;
    }

    private void ClearSearch()
    {
        searchQuery = "";
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await Close();
        }
    }

    private async Task OpenNote(Note note)
    {
        AppState.PendingOpenNoteId = note.Id;
        await Close();
        Navigation.NavigateTo("notes");
        AppState.NotifyStateChanged();
    }

    private async Task OpenSchedule()
    {
        await Close();
        Navigation.NavigateTo("schedule");
    }

    private async Task OpenAnnouncements()
    {
        await Close();
        Navigation.NavigateTo("announcements");
    }
}
