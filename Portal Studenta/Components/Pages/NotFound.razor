@page "/not-found"
@layout MainLayout
@implements IDisposable
@inject Portal_Studenta.Services.AppState AppState

<div class="view-section active" style="text-align: center; padding: 60px 20px;">
    <div style="font-size: 3rem; margin-bottom: 12px;">🧭</div>
    <h3>@(AppState.Language == "en-US" ? "Page Not Found" : "Nie znaleziono strony")</h3>
    <p style="color: var(--text-muted);">
        @(AppState.Language == "en-US"
            ? "Sorry, the content you are looking for does not exist."
            : "Przepraszamy, szukana zawartość nie istnieje.")
    </p>
</div>

@code {
    protected override void OnInitialized()
    {
        AppState.OnChange += OnAppStateChanged;
    }

    private void OnAppStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AppState.OnChange -= OnAppStateChanged;
    }
}
