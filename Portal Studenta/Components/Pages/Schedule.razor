    private int CalendarHourHeight
    {
        get
        {
            if (customFitHourHeight > 0) return customFitHourHeight;
            if (isFitToScreen)
            {
                int totalHours = Math.Max(1, EndHour - StartHour);
                if (totalHours <= 9) return 48;
                if (totalHours <= 10) return 44;
                if (totalHours <= 11) return 40;
                if (totalHours <= 12) return 37;
                return 34;
            }
            return 56;
        }
