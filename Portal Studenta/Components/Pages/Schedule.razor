    private async Task ActionSaveEvent()
    {
        if (isModalActionInProgress) return;
        if (string.IsNullOrWhiteSpace(newEvTitle))
        {
            Layout?.ShowToast(CurrentLang == "en-US" ? "Please enter event title!" : "Podaj tytuł wydarzenia!", MainLayout.ToastType.Warning);
            return;
        }

        var start = newEvStartDate.ToDateTime(new TimeOnly(newEvStartHour, newEvStartMinute));
        var end = newEvEndDate.ToDateTime(new TimeOnly(newEvEndHour, newEvEndMinute));
        if (end <= start)
        {
            Layout?.ShowToast(CurrentLang == "en-US" ? "End time must be after start time!" : "Godzina zakończenia musi być późniejsza niż godzina rozpoczęcia!", MainLayout.ToastType.Warning);
            return;
        }

        isModalActionInProgress = true;
        try
        {

            var newEvent = new Lesson 
            { 
                Id = ScheduleLogic.GenerateUniqueEventId(ScheduleService.CustomEvents.Select(c => c.Id)), 
                Title = newEvTitle, 
                Desc = newEvDesc, 
                Start = start, 
                End = end, 
                OriginalStart = start, 
                OriginalEnd = end, 
                Place = string.IsNullOrWhiteSpace(newEvPlace) ? "Brak miejsca" : newEvPlace, 
                OriginalPlace = string.IsNullOrWhiteSpace(newEvPlace) ? "Brak miejsca" : newEvPlace, 
                Type = newEvGlobal ? "STAR" : "WŁASNE", 
                IsPersonal = !newEvGlobal, 
                Group = newEvGlobal ? "ALL" : "JA", 
                Person = newEvGlobal ? (AppState.IsStarosta ? "Starosta" : "Admin") : "Ja", 
                IsHighPriority = newEvImportant 
            };
            
            await ScheduleService.AddCustomEventAsync(newEvent);
            HapticHelper.TriggerSuccess();
            
            Layout?.ShowToast(newEvGlobal 
                ? (CurrentLang == "en-US" ? "Cohort event published to cloud!" : "Opublikowano wydarzenie rocznika w chmurze!") 
                : (CurrentLang == "en-US" ? "Personal event saved and synced across devices!" : "Zapisano własne wydarzenie (zsynchronizowano z chmurą)!"));
            CloseModals();
            RecalculateWeekMetrics();
            StateHasChanged();
            AppState.NotifyStateChanged();
        }
        finally
        {
            isModalActionInProgress = false;
        }
    }

