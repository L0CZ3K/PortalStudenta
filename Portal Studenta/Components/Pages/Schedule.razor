    private async Task ExecuteCalendarExport()
    {
        var prepared = ScheduleService.GetPreparedData();
        IEnumerable<Lesson> lessonsToExport = exportScope == "week"
            ? prepared.Where(l => l.Start >= CurrentWeekStart && l.Start < CurrentWeekStart.AddDays(DaysToDisplay))
            : prepared;

        if (!lessonsToExport.Any())
        {
            Layout?.ShowToast(CurrentLang == "en-US" ? "No classes to export in selected range." : "Brak zajęć do wyeksportowania w wybranym zakresie.", MainLayout.ToastType.Warning);
            return;
        }

        try
        {
            await CalendarExportService.ExportToSystemCalendarAsync(lessonsToExport, exportWithAlarms);
            CloseModals();
            Layout?.ShowToast(CurrentLang == "en-US" ? "Opening Calendar..." : "Otwieranie Kalendarza...", MainLayout.ToastType.Success);
        }
        catch (Exception ex)
        {
            Layout?.ShowToast($"Błąd eksportu: {ex.Message}", MainLayout.ToastType.Error);
        }
    }

