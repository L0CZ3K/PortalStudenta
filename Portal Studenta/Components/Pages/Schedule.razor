@if (IsMoveModalOpen)
{
    <div class="modal-overlay active" @onclick="CloseModals">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-sheet-handle"></div>
            <button class="close-modal" @onclick="CloseModals">&times;</button>
            
            <h2 class="modal-title" style="color: var(--primary-color);">
                🕒 @(CurrentLang == "en-US" ? "Reschedule class" : "Przesuń termin")
