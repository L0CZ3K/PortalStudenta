    {
        if (CurrentView == "Calendar" && isFitToScreen)
        {
            try
            {
                int h = await JS.InvokeAsync<int>("getCalendarFitHourHeight", Math.Max(1, EndHour - StartHour));
                if (h > 0 && h != customFitHourHeight)
                {
                    customFitHourHeight = h;
                    StateHasChanged();
