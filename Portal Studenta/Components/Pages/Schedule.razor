                <label style="font-weight: 600; font-size: 0.82rem; color: var(--text-muted); display: block; margin-bottom: 4px;">@(CurrentLang == "en-US" ? "New date:" : "Nowa data:")</label>
                <input type="date" class="form-control" style="background: var(--input-bg); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px; border-radius: 10px; width: 100%; color-scheme: dark;" @bind="moveDate" @bind:format="yyyy-MM-dd" min="2024-01-01" max="2035-12-31" />
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 16px;">
                <div class="form-group" style="margin-bottom: 0;">
                    <label style="font-weight: 600; font-size: 0.82rem; color: var(--text-muted); display: block; margin-bottom: 4px;">@(CurrentLang == "en-US" ? "Start time:" : "Godzina startu:")</label>
                    <div style="display: flex; gap: 4px; align-items: center;">
                        <select class="form-control" style="flex: 1; min-width: 0; background: var(--input-bg); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 4px; border-radius: 10px; text-align: center; font-weight: 600;" value="@moveStartTime.Hour" @onchange="OnMoveStartHourChanged">
