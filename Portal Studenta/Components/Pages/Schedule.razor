    private async Task JumpToToday()
    {
        HapticHelper.TriggerClick();
        var today = DateTime.Today;
        int diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
        CurrentWeekStart = today.AddDays(-diff);
        SelectedMobileDayIndex = GetTodayIndex();
        await LoadWeekDataAsync();
    }

    private async Task ForceRefreshScheduleAsync()
    {
        if (isLoading) return;
        HapticHelper.TriggerClick();
        scheduleErrorMessage = null;
        hasAuthError = false;
        await LoadWeekDataAsync(force: true);
        if (string.IsNullOrEmpty(scheduleErrorMessage))
        {
            HapticHelper.TriggerSuccess();
            Layout?.ShowToast(CurrentLang == "en-US" ? "Timetable updated from USOS." : "Plan zajęć zaktualizowany z USOS.", MainLayout.ToastType.Success);
        }
    }

    private void NavigateToLogin()
    {
        UsosAuthService.NotifySessionExpired();
        Navigation.NavigateTo("/login", true);
    }

    private void OnConnectivityChanged(object? sender, ConnectivityChangedEventArgs e)
    {
        var wasOffline = isOffline;
        isOffline = e.NetworkAccess != NetworkAccess.Internet;
        if (wasOffline != isOffline)
        {
            if (isOffline)
            {
                HapticHelper.TriggerWarning();
            }
            InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        CurrentLang = AppState.Language;
        var today = DateTime.Today;
        int diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
        CurrentWeekStart = today.AddDays(-diff);
        CurrentView = "List";
        SelectedMobileDayIndex = GetTodayIndex(); // Na liście domyślnie zaznaczony dzisiejszy dzień

        AppState.OnChange += OnAppStateChanged;
        ScheduleService.OnScheduleLoaded += OnScheduleDataChanged;

        try
        {
            isOffline = Connectivity.Current.NetworkAccess != NetworkAccess.Internet;
            Connectivity.Current.ConnectivityChanged += OnConnectivityChanged;
        }
        catch
        {
            // Ignoruj na platformach bez monitoringu sieci
        }

        _timer = new System.Timers.Timer(60000);
        _timer.Elapsed += (s, e) => InvokeAsync(StateHasChanged);
        _timer.Start();

        await LoadWeekDataAsync();
    }

    private void OnScheduleDataChanged()
    {
        InvokeAsync(() =>
        {
            RecalculateWeekMetrics();
            StateHasChanged();
        });
    }

    private void OnAppStateChanged()
    {
        CurrentLang = AppState.Language;
        InvokeAsync(StateHasChanged);
    }

    private async Task OnGodModeToggled()
    {
        if (!IsGodMode)
        {
            isGodModeLoading = false;
            isLoading = false;
            RecalculateWeekMetrics();
            StateHasChanged();
            return;
        }

        isGodModeLoading = true;
        isLoading = true;
        StateHasChanged();

        try
        {
            await LoadWeekDataAsync(force: true);
        }
        finally
        {
            isGodModeLoading = false;
            isLoading = false;
            RecalculateWeekMetrics();
            StateHasChanged();
        }
    }

    private async Task LoadWeekDataAsync(bool force = false)
    {
        scheduleErrorMessage = null;
        hasAuthError = false;
        try
        {
            var weekEnd = CurrentWeekStart.AddDays(7);
            var prepared = ScheduleService.GetPreparedData(IsGodMode);
            bool hasAnyLessons = prepared.Any();
            bool hasWeekLessons = prepared.Any(l => l.Start >= CurrentWeekStart && l.Start < weekEnd);

            bool isFresh = IsGodMode 
                ? ScheduleService.IsGodModeFresh(CurrentWeekStart, DaysToDisplay)
                : ScheduleService.IsCacheFresh;

            // Jeśli mamy dane na ten tydzień w pamięci i są świeże oraz nie wymuszono:
            if (hasWeekLessons && isFresh && !force)
            {
                isLoading = false;
                RecalculateWeekMetrics();
                StateHasChanged();
                return;
            }

            // Jeśli nie ma danych dla tego tygodnia w pamięci/cache:
            if (!hasWeekLessons)
            {
                isLoading = true;
                StateHasChanged();

                // Jeśli pamięć podręczna jest całkowicie pusta (np. po wyczyszczeniu danych) lub wymuszono:
                // Pobieramy 35 dni (5 tygodni), aby zapełnić cały miesiąc!
                int daysToFetch = (!hasAnyLessons || force) ? 35 : 14;
                var fetchStart = (!hasAnyLessons || force) ? CurrentWeekStart.AddDays(-7) : CurrentWeekStart;

                await ScheduleService.EnsureDataLoadedAsync(UsosApiService, fetchStart, daysToFetch, force: force, godMode: IsGodMode);
                RecalculateWeekMetrics();
            }
            else
            {
                // Mamy dane w pamięci podręcznej, ale minął czas ważności lub wymuszono:
                // Natychmiast pokazujemy lokalne dane, a w tle odświeżamy
                isLoading = false;
                RecalculateWeekMetrics();
                StateHasChanged();

                int daysToFetch = force ? 35 : 7;
                var fetchStart = force ? CurrentWeekStart.AddDays(-7) : CurrentWeekStart;

                await ScheduleService.EnsureDataLoadedAsync(UsosApiService, fetchStart, daysToFetch, force: force, godMode: IsGodMode);
                RecalculateWeekMetrics();
            }
        }
        catch (UnauthorizedAccessException authEx)
        {
            hasAuthError = true;
            scheduleErrorMessage = ScheduleLogic.FormatUsosErrorMessage(authEx.Message, CurrentLang);
            Console.WriteLine("[Schedule] Błąd autoryzacji USOS: " + authEx);
            Layout?.ShowToast(scheduleErrorMessage, MainLayout.ToastType.Error);
            UsosAuthService.NotifySessionExpired();
        }
        catch (Exception ex)
        {
            scheduleErrorMessage = ScheduleLogic.FormatUsosErrorMessage(ex.Message, CurrentLang);
            Console.WriteLine("[Schedule] Błąd pobierania planu: " + ex);
            Layout?.ShowToast(scheduleErrorMessage, MainLayout.ToastType.Warning);
        }
        finally
        {
            isLoading = false;
            RecalculateWeekMetrics();
            StateHasChanged();
        }
    }

    private async Task NextWeek() 
    { 
        HapticHelper.TriggerClick();
        CurrentWeekStart = CurrentWeekStart.AddDays(7); 
        await LoadWeekDataAsync(); 
    }
    
    private async Task PrevWeek() 
    { 
        HapticHelper.TriggerClick();
        CurrentWeekStart = CurrentWeekStart.AddDays(-7); 
        await LoadWeekDataAsync(); 
    }

    private void ToggleModified() 
    { 
        ShowModified = !ShowModified;
        RecalculateWeekMetrics();
        StateHasChanged();
    }

    private void RecalculateWeekMetrics()
    {
        var allData = ScheduleService.GetPreparedData(IsGodMode).Concat(ScheduleService.CustomEvents).ToList();
        LessonsInWeek = allData.Where(l => 
        {
            var effStart = ShowModified ? l.Start : (l.OriginalStart != default ? l.OriginalStart : l.Start);
            var effEnd = ShowModified ? l.End : (l.OriginalEnd != default ? l.OriginalEnd : l.End);
            return effEnd >= CurrentWeekStart && effStart < CurrentWeekStart.AddDays(7) && (!(!ShowModified && l.IsPersonal));
        }).ToList();

        bool hasWeekend = LessonsInWeek.Any(l => {
            var d = ShowModified ? l.Start.DayOfWeek : (l.OriginalStart != default ? l.OriginalStart.DayOfWeek : l.Start.DayOfWeek);
            return d == DayOfWeek.Saturday || d == DayOfWeek.Sunday;
        });

        bool todayIsWeekend = (DateTime.Today >= CurrentWeekStart && DateTime.Today < CurrentWeekStart.AddDays(7)) &&
                              (DateTime.Today.DayOfWeek == DayOfWeek.Saturday || DateTime.Today.DayOfWeek == DayOfWeek.Sunday);

        DaysToDisplay = (hasWeekend || todayIsWeekend) ? 7 : 5;

        if (LessonsInWeek.Any())
        {
            var minH = LessonsInWeek.Min(l => ShowModified ? l.Start.Hour : (l.OriginalStart != default ? l.OriginalStart.Hour : l.Start.Hour));
            
            var maxH = LessonsInWeek.Max(l => {
                var s = ShowModified ? l.Start : (l.OriginalStart != default ? l.OriginalStart : l.Start);
                var e = ShowModified ? l.End : (l.OriginalEnd != default ? l.OriginalEnd : l.End);
                if (e.Date > s.Date || e.Hour == 0 || e.Hour < s.Hour) return 18;
                int endH = e.Minute > 0 ? e.Hour + 1 : e.Hour;
                return Math.Max(s.Hour, endH);
            });
            
            StartHour = Math.Max(0, Math.Min(8, minH));
            EndHour = Math.Min(23, Math.Max(18, maxH));
        }
        else 
        {
            StartHour = 8;
            EndHour = 18; 
        }
    }

    private IEnumerable<Lesson> GetLessonsForDay(DateTime date)
    {
        var allData = ScheduleService.GetPreparedData(IsGodMode).Concat(ScheduleService.CustomEvents);
        if (!ShowModified)
        {
            return allData.Where(l => !l.IsPersonal && 
                ((l.OriginalStart != default ? l.OriginalStart.Date : l.Start.Date) <= date.Date && 
                 (l.OriginalEnd != default ? l.OriginalEnd.Date : l.End.Date) >= date.Date))
                .OrderBy(l => l.OriginalStart != default ? l.OriginalStart : l.Start);
        }
        return allData.Where(l => l.Start.Date <= date.Date && l.End.Date >= date.Date).OrderBy(l => l.Start);
    }

    private List<ScheduleLogic.CalendarEventSlice> GetCalendarEvents(DateTime date)
    {
        var lessons = GetLessonsForDay(date);
        var slices = lessons
            .Select(l => ScheduleLogic.SliceLessonForDay(l, date, StartHour, EndHour, ShowModified))
            .Where(s => s != null)
            .Select(s => s!)
            .ToList();

        return ScheduleLogic.CalculateEventLayout(slices);
    }

    private string GetBorderColor(Lesson l)
    {
        if (l.IsHighPriority) return "var(--danger-color)";
        var type = l.Type.ToUpper();
        if (type == "WYK") return "var(--color-wyklad, #10b981)"; 
        if (type == "CW") return "var(--color-cwiczenia, #f59e0b)";
        if (type == "LAB") return "var(--color-lab, #3b82f6)"; 
        if (type == "LEKT") return "var(--color-lekt, #ec4899)";
        if (type == "STAR") return "var(--color-starosta, #f97316)"; 
        if (type == "WŁASNE") return "var(--primary-color)";
        return "var(--border-color, #334155)"; 
    }

