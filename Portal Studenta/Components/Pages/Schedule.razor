    private bool IsTaskExamModalOpen = false;
    private string TaskType = "";
    private string taskTitle = ""; private string taskDesc = ""; private bool taskGlobal = false;
    private bool IsMoveModalOpen = false;
    private DateOnly moveDate = DateOnly.FromDateTime(DateTime.Today);
    private TimeOnly moveStartTime = new(10, 0);
    private TimeOnly moveEndTime = new(11, 30);
    
    private bool IsRoomModalOpen = false;
    private string newRoom = "";
    private string roomModalScope = "one"; // "one" | "all"
    private bool isModalActionInProgress = false;

    private bool isOffline = false;
    private string? scheduleErrorMessage = null;
    private bool hasAuthError = false;

    private bool IsCurrentWeek
    {
        get
        {
            var today = DateTime.Today;
            int diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
            var thisMonday = today.AddDays(-diff);
            return CurrentWeekStart.Date == thisMonday.Date;
        }
