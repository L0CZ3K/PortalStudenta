                <input type="date" class="form-control" style="background: var(--input-bg); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px; border-radius: 10px; width: 100%; color-scheme: dark;" @bind="moveDate" @bind:format="yyyy-MM-dd" min="2024-01-01" max="2035-12-31" />
