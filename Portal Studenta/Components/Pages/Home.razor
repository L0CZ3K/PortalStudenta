                    <div style="display: flex; gap: 4px; align-items: center;">
                        <select class="form-control" style="flex: 1; min-width: 0; background: var(--input-bg); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 4px; border-radius: 10px; text-align: center; font-weight: 600;" value="@moveEndTime.Hour" @onchange="OnMoveEndHourChanged">
                            @for (int h = 0; h <= 23; h++)
                            {
                                <option value="@h">@(h < 10 ? $"0{h}" : $"{h}")</option>
                            }
                        </select>
                        <span style="font-weight: bold; color: var(--text-muted); flex-shrink: 0;">:</span>
                        <select class="form-control" style="flex: 1; min-width: 0; background: var(--input-bg); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 4px; border-radius: 10px; text-align: center; font-weight: 600;" value="@moveEndTime.Minute" @onchange="OnMoveEndMinuteChanged">
                            @for (int m = 0; m <= 59; m++)
