@code {
    [CascadingParameter] public Layout.MainLayout? Layout { get; set; }

    private bool IsGridView = false;
    private bool isSkeletonVisible = true;
    private string CurrentLang = "pl-PL";

    private List<Portal_Studenta.Services.AnnouncementItem> PriorityNews = new();
    private List<Portal_Studenta.Services.AnnouncementItem> RecentAnnouncements = new();
    private Lesson? OngoingEvent;
    private Lesson? UpcomingEvent;
    private List<Lesson> Upcoming48h = new();

    // Aktywna ankieta grupy
    private GroupPoll? ActivePoll;

    private Lesson? SelectedLesson;
    private Portal_Studenta.Services.AnnouncementItem? SelectedAnnouncement;
    private bool IsLessonModalOpen = false;
    private bool IsNewsModalOpen = false;
    
    private bool IsMoveModalOpen = false;
    private DateOnly moveDate = DateOnly.FromDateTime(DateTime.Today);
    private TimeOnly moveStartTime = new(10, 0);
    private TimeOnly moveEndTime = new(11, 30);
    private bool IsRoomModalOpen = false;
    private string newRoom = "";

    private void OnMoveStartHourChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int h))
            moveStartTime = new TimeOnly(h, moveStartTime.Minute);
    }
    private void OnMoveStartMinuteChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int m))
            moveStartTime = new TimeOnly(moveStartTime.Hour, m);
    }
    private void OnMoveEndHourChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int h))
            moveEndTime = new TimeOnly(h, moveEndTime.Minute);
    }
    private void OnMoveEndMinuteChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int m))
            moveEndTime = new TimeOnly(moveEndTime.Hour, m);
    }
    
    private System.Timers.Timer? _timer;
    private bool _isBackgroundRefreshing = false;

    protected override async Task OnInitializedAsync()
    {
        CurrentLang = AppState.Language;
        AppState.OnChange += OnAppStateChanged;
        ScheduleService.OnScheduleLoaded += OnScheduleDataChanged;

        // Natychmiastowe wyświetlenie danych z pamięci podręcznej bez czekania na sieć (0 ms delay)
        var cachedEvents = ScheduleService.GetAllEvents();
        if (cachedEvents.Any())
        {
            isSkeletonVisible = false;
            RecalculateScheduleView();
        }
        else
        {
            isSkeletonVisible = true;
        }

        // Asynchroniczne pobieranie danych i ankiet w tle bez blokowania pierwszego renderu
        _ = LoadDataAsync();
        _ = LoadActivePollAsync();

        // Timer (10s) aktualizuje licznik trwających zajęć i odliczanie, sprawdza USOS oraz odświeża ankietę co 30s
        _timer = new System.Timers.Timer(10000);
        int pollCounter = 0;
        _timer.Elapsed += async (s, e) => await InvokeAsync(async () =>
        {
            try
            {
                RecalculateScheduleView();
                CheckHourlyCacheRefresh();
                if (++pollCounter % 3 == 0)
                {
                    await LoadActivePollAsync();
                }
                StateHasChanged();
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"[Home] Timer refresh error: {ex.Message}");
            }
        });
        _timer.Start();

        await Task.CompletedTask;
    }

    private void OnScheduleDataChanged()
    {
        InvokeAsync(() =>
        {
            RecalculateScheduleView();
            StateHasChanged();
        });
    }

    private void OnAppStateChanged()
    {
        CurrentLang = AppState.Language;
        _ = LoadActivePollAsync();
        InvokeAsync(StateHasChanged);
    }

    private async Task LoadDataAsync()
    {
        if (!ProfileService.IsLoaded)
        {
            _ = Task.Run(async () =>
            {
                try { await ProfileService.LoadProfileAsync(); }
                catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[Home] LoadProfileAsync error: {ex.Message}"); }
            });
        }

        int diff = (7 + (DateTime.Today.DayOfWeek - DayOfWeek.Monday)) % 7;
        var thisMonday = DateTime.Today.AddDays(-diff);

        var allEvents = ScheduleService.GetAllEvents();

        if (!allEvents.Any())
        {
            // Brak danych w pamięci podręcznej (np. po pierwszym logowaniu) -> pobieramy z USOS z widocznym skeletonem
            isSkeletonVisible = true;
            await InvokeAsync(StateHasChanged);

            try
            {
                await ScheduleService.EnsureDataLoadedAsync(UsosApiService, thisMonday, 35, force: true);
            }
            catch (UnauthorizedAccessException authEx)
            {
                Console.WriteLine($"[Home] Błąd autoryzacji USOS: {authEx.Message}");
                Layout?.ShowToast(ScheduleLogic.FormatUsosErrorMessage(authEx.Message, CurrentLang), MainLayout.ToastType.Error);
                UsosAuthService.NotifySessionExpired();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Home] Błąd pierwszego pobierania USOS: {ex.Message}");
            }
        }
        else
        {
            // Mamy dane w pamięci podręcznej urządzenia -> natychmiast pokazujemy bez opóźnień
            isSkeletonVisible = false;
            RecalculateScheduleView();
            await InvokeAsync(StateHasChanged);

            _ = Task.Run(async () =>
            {
                try
                {
                    await ScheduleService.SyncCloudEventsAsync();
                }
                catch (Exception ex)
                {
                    System.Diagnostics.Debug.WriteLine($"[Home] SyncCloudEventsAsync error: {ex.Message}");
                }
            });

            // Jeśli minęła ponad godzina od ostatniego pobrania, odświeżamy w tle
            CheckHourlyCacheRefresh();
        }

        // Pobranie ogłoszeń z Firebase
        try
        {
            var allAnnouncements = await AnnouncementService.GetAnnouncementsAsync();
            PriorityNews = allAnnouncements.Where(a => a.IsSystem).ToList();
            // W sekcji „Tablica ogłoszeń” pokazujemy wiadomości od starosty/wydziału (wykluczamy dev/system, bo są u góry)
            RecentAnnouncements = allAnnouncements
                .Where(a => !a.IsSystem && !string.Equals(a.Author, "dev", StringComparison.OrdinalIgnoreCase) && !string.Equals(a.Author, "system", StringComparison.OrdinalIgnoreCase))
                .Take(3)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Home] Błąd pobierania ogłoszeń: {ex.Message}");
        }

        RecalculateScheduleView();
        isSkeletonVisible = false;
        await InvokeAsync(StateHasChanged);
    }

    private void CheckHourlyCacheRefresh()
    {
        if (ScheduleService.HasUsosAuthError)
        {
            return;
        }

        if (!ScheduleService.IsCacheFresh && !_isBackgroundRefreshing)
        {
            _isBackgroundRefreshing = true;
            int diff = (7 + (DateTime.Today.DayOfWeek - DayOfWeek.Monday)) % 7;
            var thisMonday = DateTime.Today.AddDays(-diff);

            _ = Task.Run(async () =>
            {
                try
                {
                    await ScheduleService.EnsureDataLoadedAsync(UsosApiService, thisMonday, 14, force: true);
                }
                catch (UnauthorizedAccessException authEx)
                {
                    Console.WriteLine($"[Home] Sesja USOS wygasła podczas odświeżania w tle: {authEx.Message}");
                    UsosAuthService.NotifySessionExpired();
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[Home] Błąd godzinnego odświeżania USOS w tle: {ex.Message}");
                }
                finally
                {
                    _isBackgroundRefreshing = false;
                }
            });
        }
    }

    private void RecalculateScheduleView()
    {
        var allEvents = ScheduleService.GetAllEvents();
        var now = DateTime.Now;

        OngoingEvent = allEvents.FirstOrDefault(e => !e.IsCanceled && e.Start <= now && e.End > now);

        var todayEvents = allEvents
            .Where(e => !e.IsCanceled && e.Start > now && e.Start.Date == now.Date)
            .OrderBy(e => e.Start)
            .ToList();
        UpcomingEvent = todayEvents.FirstOrDefault();

        Upcoming48h = allEvents
            .Where(e => !e.IsCanceled && e.Start > now && e.Start <= now.AddHours(48) && e != UpcomingEvent && e != OngoingEvent)
            .OrderBy(e => e.Start)
            .Take(4)
            .ToList();
    }

    private int GetOngoingMinutes()
    {
        if (OngoingEvent == null) return 0;
        return Math.Max(0, (int)(DateTime.Now - OngoingEvent.Start).TotalMinutes);
    }

    private string GetCountdownText()
    {
        if (UpcomingEvent == null) return "";
        var diff = UpcomingEvent.Start - DateTime.Now;
        if (diff.TotalHours >= 1)
            return CurrentLang == "en-US" ? $"In {(int)diff.TotalHours}h {diff.Minutes}m" : $"Za {(int)diff.TotalHours}h {diff.Minutes}m";
        return CurrentLang == "en-US" ? $"In {Math.Max(1, diff.Minutes)}m" : $"Za {Math.Max(1, diff.Minutes)}m";
    }

    private string GetColor(Lesson l)
    {
        if (l.IsHighPriority) return "color-danger";
        
        var type = (l.Type ?? "").ToUpperInvariant();
        if (type == "WYK") return "color-wyklad";
        if (type == "CW") return "color-cwiczenia";
        if (type == "LAB") return "color-lab";
        if (type == "LEKT") return "color-lekt";
        if (type == "STAR") return "color-starosta";
        
        return "color-event";
    }

    private string GetAccentClass(Lesson l)
    {
        if (l.IsHighPriority) return "accent-danger";
        var type = (l.Type ?? "").ToUpperInvariant();
        if (type == "WYK") return "accent-wyklad";
        if (type == "CW") return "accent-cw";
        if (type == "LAB") return "accent-lab";
        if (type == "LEKT") return "accent-lekt";
        if (type == "STAR") return "accent-star";
        return "";
    }

    private string GetTypePillClass(Lesson l)
    {
        var type = (l.Type ?? "").ToUpperInvariant();
        if (type == "WYK") return "type-pill wyklad";
        if (type == "CW") return "type-pill cw";
        if (type == "LAB") return "type-pill lab";
        if (type == "LEKT") return "type-pill lekt";
        if (type == "STAR") return "type-pill star";
        return "type-pill";
    }

    private string GetNewsCardClass(Portal_Studenta.Services.AnnouncementItem a)
    {
        if (a.IsSystem) return "color-system";
        if (a.IsPriority) return "color-danger";
        return "color-inne";
    }

    private void OpenLessonModal(Lesson lesson) { SelectedLesson = lesson; IsLessonModalOpen = true; }
    private void OpenNewsModal(Portal_Studenta.Services.AnnouncementItem item) { SelectedAnnouncement = item; IsNewsModalOpen = true; }
    
    private void OpenMoveModal() 
    { 
        if (SelectedLesson != null)
        {
            var start = SelectedLesson.Start.Year < 2024 ? DateTime.Today.AddHours(SelectedLesson.Start.Hour).AddMinutes(SelectedLesson.Start.Minute) : SelectedLesson.Start;
            var end = SelectedLesson.End.Year < 2024 ? start.AddHours(1.5) : SelectedLesson.End;
            moveDate = DateOnly.FromDateTime(start);
            moveStartTime = TimeOnly.FromDateTime(start);
            moveEndTime = TimeOnly.FromDateTime(end);
        }
        IsLessonModalOpen = false; 
        IsMoveModalOpen = true; 
    }

    private void OpenRoomModal()
    {
        if (SelectedLesson != null)
        {
            newRoom = SelectedLesson.Place ?? "";
        }
        IsLessonModalOpen = false;
        IsRoomModalOpen = true;
    }

    private void CloseModals()
    {
        IsLessonModalOpen = false;
        IsNewsModalOpen = false;
        IsMoveModalOpen = false;
        IsRoomModalOpen = false;
    }

    private async Task ToggleCancelLesson()
    {
        if (SelectedLesson != null)
        {
            if (SelectedLesson.IsCanceled)
            {
                await ScheduleService.RestoreLessonAsync(SelectedLesson);
            }
            else
            {
                await ScheduleService.CancelLessonAsync(SelectedLesson);
            }
            await LoadDataAsync();
        }
    }

    private async Task ActionMove()
    {
        if (SelectedLesson != null)
        {
            var newStart = moveDate.ToDateTime(moveStartTime);
            var newEnd = moveDate.ToDateTime(moveEndTime);

            if (newEnd <= newStart)
            {
                Layout?.ShowToast(CurrentLang == "en-US" ? "End time must be after start time!" : "Godzina zakończenia musi być późniejsza niż start!", MainLayout.ToastType.Warning);
                return;
            }

            await ScheduleService.RescheduleLessonAsync(SelectedLesson, newStart, newEnd);
            Layout?.ShowToast(CurrentLang == "en-US" ? "Class rescheduled." : "Termin zajęć został przesunięty.", MainLayout.ToastType.Success);
            CloseModals();
            await LoadDataAsync();
        }
    }

    private async Task ActionRoom()
    {
        if (SelectedLesson != null && !string.IsNullOrWhiteSpace(newRoom))
        {
            await ScheduleService.ChangeRoomAsync(SelectedLesson, newRoom);
            CloseModals();
            await LoadDataAsync();
        }
    }

    private async Task DeleteAnnouncement()
    {
        if (SelectedAnnouncement != null)
        {
            bool isProtected = SelectedAnnouncement.IsSystem ||
                               string.Equals(SelectedAnnouncement.Author, "dev", StringComparison.OrdinalIgnoreCase) ||
                               string.Equals(SelectedAnnouncement.Author, "system", StringComparison.OrdinalIgnoreCase);
            if (AppState.HasManagementPrivileges && !isProtected)
            {
                await AnnouncementService.DeleteAnnouncementAsync(SelectedAnnouncement);
                Layout?.ShowToast(CurrentLang == "en-US" ? "Announcement deleted." : "Ogłoszenie zostało usunięte.", MainLayout.ToastType.Warning);
            }
            CloseModals();
            await LoadDataAsync();
        }
    }

    private string GetUserAlbum()
    {
        string id = ProfileService.StudentNumber;
        if (string.IsNullOrEmpty(id)) id = Preferences.Default.Get("user_student_number", "");
        if (string.IsNullOrEmpty(id)) id = Preferences.Default.Get("user_usos_id", "");
        return id;
    }

    private async Task LoadActivePollAsync()
    {
        if (string.IsNullOrEmpty(AppState.GroupCode))
        {
            ActivePoll = null;
            return;
        }

        try
        {
            var polls = await FirebaseService.GetGroupPollsAsync(AppState.GroupCode);
            ActivePoll = polls.FirstOrDefault(p => !p.IsClosed);
            if (ActivePoll != null)
            {
                var knownPollsRaw = Preferences.Default.Get("known_group_polls", "");
                var knownPolls = (knownPollsRaw ?? "").Split(';', StringSplitOptions.RemoveEmptyEntries).ToHashSet();
                if (!knownPolls.Contains(ActivePoll.Id))
                {
                    knownPolls.Add(ActivePoll.Id);
                    Preferences.Default.Set("known_group_polls", string.Join(";", knownPolls.TakeLast(30)));
                    if (!string.IsNullOrEmpty(knownPollsRaw))
                    {
                        NotificationService.NotifyNewPoll(ActivePoll);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Home] Błąd LoadActivePollAsync: {ex.Message}");
        }
    }

    private async Task VoteInPollAsync(int optionIndex)
    {
        if (ActivePoll == null) return;
        string myAlbum = GetUserAlbum();
        if (string.IsNullOrEmpty(myAlbum))
        {
            Layout?.ShowToast(CurrentLang == "en-US" ? "Please sign in to vote!" : "Zaloguj się, aby oddać głos!", MainLayout.ToastType.Warning);
            return;
        }

        string safeAlbum = FirebaseService.SanitizeKey(myAlbum.Trim().ToUpperInvariant());
        if (ActivePoll.Votes == null) ActivePoll.Votes = new Dictionary<string, int>();
        ActivePoll.Votes[safeAlbum] = optionIndex;
        StateHasChanged();

        bool success = await FirebaseService.VoteGroupPollAsync(AppState.GroupCode, ActivePoll.Id, myAlbum, optionIndex);
        if (success)
        {
            HapticHelper.TriggerSuccess();
            Layout?.ShowToast(CurrentLang == "en-US" ? "Vote recorded!" : "Twój głos został zapisany!", MainLayout.ToastType.Success);
        }
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
        _timer = null;
        AppState.OnChange -= OnAppStateChanged;
        ScheduleService.OnScheduleLoaded -= OnScheduleDataChanged;
    }
}
