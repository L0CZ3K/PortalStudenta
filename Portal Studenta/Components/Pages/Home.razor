@page "/"
@implements IDisposable
@using Portal_Studenta.Models
@inject Portal_Studenta.Services.ScheduleService ScheduleService
@inject Portal_Studenta.Services.AnnouncementService AnnouncementService
@inject NavigationManager NavigationManager
@inject Portal_Studenta.Services.AppState AppState
@inject Portal_Studenta.Services.UsosApiService UsosApiService
@inject Portal_Studenta.Services.ProfileService ProfileService
@inject Portal_Studenta.Services.FirebaseService FirebaseService
@inject Portal_Studenta.Services.NotificationService NotificationService
@inject IJSRuntime JS

<style>
    .home-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        padding-top: 4px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .home-title {
        color: var(--text-main);
        margin: 0;
        font-size: 1.75rem;
        font-weight: 700;
        letter-spacing: -0.025em;
    }

    .home-subtitle {
        color: var(--text-muted);
        margin: 4px 0 0 0;
        font-size: 0.95rem;
        font-weight: 500;
    }

    .schedule-flow-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
        gap: 14px;
    }

    .schedule-flow-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    /* Skeleton na Pulpicie */
    .skeleton-card {
        background: linear-gradient(90deg, var(--card-bg) 25%, var(--border-color) 50%, var(--card-bg) 75%);
        background-size: 200% 100%;
        animation: skeletonPulse 1.5s infinite ease-in-out;
        border-radius: var(--radius);
        border: 1px solid var(--border-color);
        margin-bottom: 12px;
    }

    @@keyframes skeletonPulse {
        0% { background-position: -200%; }
        100% { background-position: 200%; }
    }
</style>

<div>
    <div class="home-header">
        <div>
            @if (ProfileService.IsLoaded && !string.IsNullOrEmpty(ProfileService.FirstName))
            {
                <h1 class="home-title">@(CurrentLang == "en-US" ? $"Hey, {ProfileService.FirstName}!" : $"Hej, {ProfileService.FirstName}!")</h1>
            }
            else
            {
                <h1 class="home-title">@(CurrentLang == "en-US" ? "Hello!" : "Cześć!")</h1>
            }
            @if (ProfileService.IsLoaded && !string.IsNullOrEmpty(ProfileService.ProgrammeName))
            {
                <p class="home-subtitle">@ProfileService.ProgrammeName</p>
            }
        </div>
        <div class="segmented-control desktop-only">
            <button class="seg-btn @(!IsGridView ? "active" : "")" @onclick="() => IsGridView = false" title='@(CurrentLang == "en-US" ? "List view" : "Widok listy")'>
                <svg class="seg-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                <span>@(CurrentLang == "en-US" ? "List" : "Lista")</span>
            </button>
            <button class="seg-btn @(IsGridView ? "active" : "")" @onclick="() => IsGridView = true" title='@(CurrentLang == "en-US" ? "Grid view" : "Widok siatki")'>
                <svg class="seg-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                <span>@(CurrentLang == "en-US" ? "Grid" : "Siatka")</span>
            </button>
        </div>
    </div>

    @if (isSkeletonVisible)
    {
        <div class="schedule-flow-grid">
            <div class="skeleton-card" style="height: 140px;"></div>
            <div class="skeleton-card" style="height: 140px;"></div>
        </div>
    }
    else
    {
        <!-- Alerty i informacje od twórców / Systemu -->
        @if (PriorityNews.Any())
        {
            <div class="schedule-flow-list" style="margin-bottom: 22px;">
                @foreach (var news in PriorityNews)
                {
                    <div class="news-widget" style="border-left: 4px solid #BF5AF2; background: rgba(191, 90, 242, 0.05);" @onclick="() => OpenNewsModal(news)">
                        <div style="display: flex; gap: 8px; align-items: center; justify-content: space-between;">
                            <div style="display: flex; gap: 8px; align-items: center;">
                                <span class="type-pill news-badge-system">🛠️ @(string.IsNullOrWhiteSpace(news.Author) ? "DEV / SYSTEM" : news.Author.ToUpper())</span>
                                @if (news.IsPriority)
                                {
                                    <span class="type-pill news-badge-important">@(CurrentLang == "en-US" ? "IMPORTANT" : "WAŻNE")</span>
                                }
                            </div>
                            <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: 500;">@news.DisplayTime</span>
                        </div>
                        <h3 class="news-widget-title" style="margin-top: 4px;">@news.Title</h3>
                        <p class="news-widget-desc">@news.ShortContent</p>
                    </div>
                }
            </div>
        }

        <!-- Sekcja „Zaraz zaczynasz” -->
        <div class="section-header">
            <div class="section-title-wrapper">
                <h2 class="section-heading">@(CurrentLang == "en-US" ? "Up next" : "Zaraz zaczynasz")</h2>
                <span class="section-subtext">@(CurrentLang == "en-US" ? "Next classes in your timetable" : "Najbliższe zajęcia w Twoim planie")</span>
            </div>
        </div>
        
        <div class="@(IsGridView ? "schedule-flow-grid" : "schedule-flow-list")">
            @if (OngoingEvent == null && UpcomingEvent == null)
            {
                <div class="empty-state-card" style="grid-column: 1 / -1;">
                    <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8h1a4 4 0 0 1 0 8h-1"/>
                        <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
                        <line x1="6" y1="1" x2="6" y2="4"/>
                        <line x1="10" y1="1" x2="10" y2="4"/>
                        <line x1="14" y1="1" x2="14" y2="4"/>
                    </svg>
                    <h3 class="empty-state-title">@(CurrentLang == "en-US" ? "All done for today!" : "Wszystko na dzisiaj gotowe!")</h3>
                    <p class="empty-state-subtitle">@(CurrentLang == "en-US" ? "No more classes scheduled today. Time to relax or catch up on study materials." : "Brak kolejnych zajęć na dziś. Możesz odpocząć lub sprawdzić materiały.")</p>
                </div>
            }
            else
            {
                @if (OngoingEvent != null)
                {
                    <div class="event-widget @GetAccentClass(OngoingEvent)" @onclick="() => OpenLessonModal(OngoingEvent)">
                        <div>
                            <div class="event-top-bar">
                                <div class="event-badges-group">
                                    <span class="@GetTypePillClass(OngoingEvent)">@OngoingEvent.Type</span>
                                    <span class="status-pill live">
                                        <span class="status-dot"></span>
                                        @(CurrentLang == "en-US" 
                                            ? (GetOngoingMinutes() <= 15 ? $"Started {GetOngoingMinutes()}m ago" : "Happening now") 
                                            : (GetOngoingMinutes() <= 15 ? $"Trwa od {GetOngoingMinutes()} min" : "Trwają teraz"))
                                    </span>
                                </div>
                                <span class="group-tag">Gr. @OngoingEvent.Group</span>
                            </div>
                            <h3 class="event-main-title">@OngoingEvent.Title</h3>
                            <p class="event-time-text">
                                <svg class="meta-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                @OngoingEvent.Start.ToString("HH:mm") – @OngoingEvent.End.ToString("HH:mm")
                            </p>
                        </div>
                        
                        <div class="event-bottom-meta">
                            <span class="meta-item">
                                <svg class="meta-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                @OngoingEvent.Place
                            </span>
                            <span class="meta-item">
                                <svg class="meta-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                @OngoingEvent.Person
                            </span>
                        </div>
                    </div>
                }

                @if (UpcomingEvent != null)
                {
                    <div class="event-widget @GetAccentClass(UpcomingEvent)" @onclick="() => OpenLessonModal(UpcomingEvent)">
                        <div>
                            <div class="event-top-bar">
                                <div class="event-badges-group">
                                    <span class="@GetTypePillClass(UpcomingEvent)">@UpcomingEvent.Type</span>
                                    <span class="status-pill countdown">
                                        <svg class="meta-svg" style="stroke: #5ac8fa;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                        @GetCountdownText()
                                    </span>
                                </div>
                                <span class="group-tag">Gr. @UpcomingEvent.Group</span>
                            </div>
                            <h3 class="event-main-title">@UpcomingEvent.Title</h3>
                            <p class="event-time-text">
                                <svg class="meta-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                @UpcomingEvent.Start.ToString("HH:mm") – @UpcomingEvent.End.ToString("HH:mm")
                            </p>
                        </div>
                        
                        <div class="event-bottom-meta">
                            <span class="meta-item">
                                <svg class="meta-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                @UpcomingEvent.Place
                            </span>
                            <span class="meta-item">
                                <svg class="meta-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                @UpcomingEvent.Person
                            </span>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Sekcja „Wkrótce (48h)” -->
        @if (Upcoming48h.Any())
        {
            <div class="section-header">
                <div class="section-title-wrapper">
                    <h2 class="section-heading">@(CurrentLang == "en-US" ? "Upcoming (48h)" : "Wkrótce (48h)")</h2>
                    <span class="section-subtext">@(CurrentLang == "en-US" ? "Coming days this week" : "Kolejne dni tygodnia")</span>
                </div>
            </div>
            
            <div class="@(IsGridView ? "schedule-flow-grid" : "schedule-flow-list")">
                @foreach (var ev in Upcoming48h)
                {
                    <div class="event-widget @GetAccentClass(ev)" @onclick="() => OpenLessonModal(ev)">
                        <div>
                            <div class="event-top-bar">
                                <div class="event-badges-group">
                                    <span class="@GetTypePillClass(ev)">@ev.Type</span>
                                </div>
                                <span style="font-weight: 600; color: var(--text-muted); font-size: 0.8rem;">@ev.Start.ToString("dd.MM (ddd)")</span>
                            </div>
                            <h3 class="event-main-title">@ev.Title</h3>
                            <p class="event-time-text">
                                <svg class="meta-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                @ev.Start.ToString("HH:mm") – @ev.End.ToString("HH:mm")
                            </p>
                        </div>
                        <div class="event-bottom-meta">
                            <span class="meta-item">
                                <svg class="meta-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                @ev.Place
                            </span>
                            <span class="meta-item">
                                <svg class="meta-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                @ev.Person
                            </span>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Sekcja „Aktywne głosowanie grupy” (Polls) -->
        @if (ActivePoll != null && ActivePoll.Options != null)
        {
            var myAlbum = GetUserAlbum();
            var safeAlbum = FirebaseService.SanitizeKey(myAlbum);
            var hasVoted = !string.IsNullOrEmpty(myAlbum) && ActivePoll.Votes != null && ActivePoll.Votes.ContainsKey(safeAlbum);
            var myVoteIdx = hasVoted ? ActivePoll.Votes![safeAlbum] : -1;

            <div style="margin-bottom: 24px; background: var(--card-bg); border: 1px solid rgba(191, 90, 242, 0.35); border-radius: var(--radius); padding: 18px; box-shadow: 0 4px 20px rgba(191, 90, 242, 0.1);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; flex-wrap: wrap; gap: 8px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="font-size: 1.25rem;">🗳️</span>
                        <span style="font-weight: 700; color: #BF5AF2; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.04em;">
                            @(CurrentLang == "en-US" ? "Cohort Poll" : "Głosowanie grupy")
                        </span>
                    </div>
                    <span style="font-size: 0.8rem; color: var(--text-muted);">
                        @ActivePoll.TotalVotes @(CurrentLang == "en-US" ? "votes" : "oddanych głosów")
                    </span>
                </div>

                <h3 style="margin: 0 0 14px 0; font-size: 1.12rem; font-weight: 700; color: var(--text-main); line-height: 1.4;">
                    @ActivePoll.Question
                </h3>

                <div style="display: flex; flex-direction: column; gap: 10px;">
                    @for (int i = 0; i < ActivePoll.Options.Count; i++)
                    {
                        var optIdx = i;
                        var optText = ActivePoll.Options[optIdx];
                        var votes = ActivePoll.GetVoteCountForOption(optIdx);
                        var pct = ActivePoll.GetPercentageForOption(optIdx);
                        var isMyChoice = myVoteIdx == optIdx;

                        <div style="position: relative; overflow: hidden; border-radius: 12px; border: 1px solid @(isMyChoice ? "#BF5AF2" : "var(--border-color)"); background: @(isMyChoice ? "rgba(191, 90, 242, 0.12)" : "rgba(255, 255, 255, 0.03)"); padding: 12px 14px; cursor: pointer; transition: all 0.2s ease;"
                             @onclick="() => VoteInPollAsync(optIdx)">
                            <!-- Pasek procentowy w tle -->
                            <div style="position: absolute; top: 0; left: 0; bottom: 0; width: @pct%; background: rgba(191, 90, 242, 0.15); pointer-events: none; transition: width 0.4s ease;"></div>

                            <div style="position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <span style="display: inline-block; width: 18px; height: 18px; border-radius: 50%; border: 2px solid @(isMyChoice ? "#BF5AF2" : "var(--text-muted)"); background: @(isMyChoice ? "#BF5AF2" : "transparent"); text-align: center; line-height: 14px; font-size: 11px; color: white; font-weight: bold;">
                                        @(isMyChoice ? "✓" : "")
                                    </span>
                                    <span style="font-weight: 600; font-size: 0.92rem; color: var(--text-main);">@optText</span>
                                </div>
                                <div style="font-size: 0.82rem; font-weight: 700; color: @(isMyChoice ? "#BF5AF2" : "var(--text-muted)");">
                                    @pct% <span style="font-weight: normal; opacity: 0.8;">(@votes)</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (hasVoted)
                {
                    <div style="margin-top: 10px; font-size: 0.78rem; color: var(--text-muted); text-align: right;">
                        @(CurrentLang == "en-US" ? "Click any option to change your vote" : "Kliknij inną opcję, aby zmienić swój głos")
                    </div>
                }
            </div>
        }

        <!-- Sekcja „Tablica ogłoszeń” -->
        <div class="section-header">
            <div class="section-title-wrapper">
                <h2 class="section-heading">@(CurrentLang == "en-US" ? "Notice board" : "Tablica ogłoszeń")</h2>
                <span class="section-subtext">@(CurrentLang == "en-US" ? "Updates from student reps and faculty" : "Wiadomości od starosty i wydziału")</span>
            </div>
            <a href="#" class="section-action-link" @onclick:preventDefault @onclick='() => NavigationManager.NavigateTo("announcements")'>
                @(CurrentLang == "en-US" ? "All →" : "Wszystkie →")
            </a>
        </div>
        
        @if (RecentAnnouncements.Count > 0)
        {
            <div class="@(IsGridView ? "schedule-flow-grid" : "schedule-flow-list")">
                @foreach (var announcement in RecentAnnouncements)
                {
                    var isSys = announcement.IsSystem || announcement.Author?.ToLower() == "dev" || announcement.Author?.ToLower() == "system";
                    <div class="news-widget" @onclick="() => OpenNewsModal(announcement)">
                        <div style="display: flex; gap: 8px; align-items: center; justify-content: space-between;">
                            <div style="display: flex; gap: 8px; align-items: center;">
                                @if (isSys)
                                {
                                    <span class="type-pill news-badge-system">🛠️ @(string.IsNullOrWhiteSpace(announcement.Author) ? "DEV" : announcement.Author.ToUpper())</span>
                                }
                                else if (announcement.IsPriority)
                                {
                                    <span class="type-pill news-badge-important">@(CurrentLang == "en-US" ? "IMPORTANT" : "WAŻNE")</span>
                                }
                                else
                                {
                                    <span class="type-pill news-badge-info">@(CurrentLang == "en-US" ? "INFO" : "INFORMACJA")</span>
                                }
                            </div>
                            <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: 500;">@announcement.DisplayTime</span>
                        </div>
                        <h3 class="news-widget-title" style="margin-top: 4px;">@announcement.Title</h3>
                        <p class="news-widget-desc">@announcement.ShortContent</p>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state-card">
                <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                <h3 class="empty-state-title">@(CurrentLang == "en-US" ? "Quiet on the board" : "Cisza na tablicy")</h3>
                <p class="empty-state-subtitle">@(CurrentLang == "en-US" ? "No new announcements. Urgent alerts will show up here." : "Brak nowych ogłoszeń. Jeśli pojawią się pilne komunikaty, zobaczysz je tutaj.")</p>
            </div>
        }

        <!-- Sekcja „UniAvio Changelog” -->
        <div class="devlog-widget">
            <div class="devlog-header">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <span class="devlog-tag">@(CurrentLang == "en-US" ? "Update" : "Aktualizacja")</span>
                    <h3 style="margin: 0; font-size: 1.05rem; font-weight: 600; color: var(--text-main);">@(CurrentLang == "en-US" ? "What's new in UniAvio?" : "Co nowego w UniAvio?")</h3>
                </div>
                <a href="#" class="section-action-link" @onclick:preventDefault @onclick='() => NavigationManager.NavigateTo("announcements")'>@(CurrentLang == "en-US" ? "Full log →" : "Pełna historia →")</a>
            </div>
            <ul class="devlog-list">
                @if (CurrentLang == "en-US")
                {
                    <li><span class="devlog-bullet"></span><span>Modern responsive interface designed natively for mobile and desktop screens.</span></li>
                    <li><span class="devlog-bullet"></span><span>Smooth bottom navigation tab bar with Dynamic Island and safe area awareness.</span></li>
                    <li><span class="devlog-bullet"></span><span>Unified course color scheme with live countdowns and room indicators.</span></li>
                }
                else
                {
                    <li><span class="devlog-bullet"></span><span>Nowoczesny responsywny interfejs zaprojektowany z myślą o telefonach i komputerach.</span></li>
                    <li><span class="devlog-bullet"></span><span>Wygodny dolny pasek nawigacji z płynną obsługą safe area dla Dynamic Island.</span></li>
                    <li><span class="devlog-bullet"></span><span>Ujednolicona paleta barw zajęć i eleganckie karty z czasem do rozpoczęcia.</span></li>
                }
            </ul>
        </div>
    }
</div>

<!-- Modale -->
@if (IsLessonModalOpen && SelectedLesson != null)
{
    <div class="modal-overlay active" @onclick="CloseModals">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-sheet-handle"></div>
            <button class="close-modal" @onclick="CloseModals">&times;</button>
            
            <div style="display: flex; gap: 8px; align-items: center;">
                <span class="type-pill @GetTypePillClass(SelectedLesson)">@SelectedLesson.Type</span>
                @if (SelectedLesson.IsCanceled)
                {
                    <span class="type-pill" style="background: rgba(255, 69, 58, 0.15); color: var(--danger-color);">@(CurrentLang == "en-US" ? "CANCELLED" : "ODWOŁANE")</span>
                }
            </div>

            <h2 class="modal-title">@SelectedLesson.Title</h2>
            
            <div class="modal-info-box">
                <div class="modal-info-row">
                    <span class="modal-info-label">🕒 @(CurrentLang == "en-US" ? "Time:" : "Godzina:")</span>
                    <span>@SelectedLesson.Start.ToString("dd.MM.yyyy") | @SelectedLesson.Start.ToString("HH:mm") – @SelectedLesson.End.ToString("HH:mm")</span>
                </div>
                <div class="modal-info-row">
                    <span class="modal-info-label">📍 @(CurrentLang == "en-US" ? "Room:" : "Sala:")</span>
                    <span>@SelectedLesson.Place</span>
                </div>
                <div class="modal-info-row">
                    <span class="modal-info-label">👤 @(CurrentLang == "en-US" ? "Lecturer:" : "Wykładowca:")</span>
                    <span>@SelectedLesson.Person</span>
                </div>
                <div class="modal-info-row">
                    <span class="modal-info-label">👥 @(CurrentLang == "en-US" ? "Group:" : "Grupa:")</span>
                    <span>Gr. @SelectedLesson.Group</span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(SelectedLesson.Desc))
            {
                <div style="background: rgba(255,255,255,0.04); padding: 14px; border-radius: 10px; margin-bottom: 18px; border-left: 3px solid var(--border-color);">
                    <p style="line-height: 1.5; font-size: 0.9rem; white-space: pre-wrap; margin: 0; color: var(--text-secondary);">@SelectedLesson.Desc</p>
                </div>
            }

            @if (AppState.HasManagementPrivileges)
            {
                <h4 style="margin-top: 10px; margin-bottom: 12px; color: var(--color-starosta); font-size: 0.88rem; text-transform: uppercase; letter-spacing: 0.04em;">
                    @(AppState.IsStarosta ? (CurrentLang == "en-US" ? "Starosta Actions" : "Akcje Starosty") : (CurrentLang == "en-US" ? "Admin Actions" : "Akcje Administratora"))
                </h4>
                <div class="modal-actions-row">
                    <button class="btn btn-danger" @onclick="ToggleCancelLesson">
                        @(SelectedLesson.IsCanceled ? (CurrentLang == "en-US" ? "Restore" : "Przywróć") : (CurrentLang == "en-US" ? "Cancel class" : "Odwołaj"))
                    </button>
                    <button class="btn" style="background-color: var(--color-wyklad); color: white;" @onclick="OpenMoveModal">
                        @(CurrentLang == "en-US" ? "Reschedule" : "Przesuń")
                    </button>
                    <button class="btn" style="background-color: var(--color-lab); color: white;" @onclick="OpenRoomModal">
                        @(CurrentLang == "en-US" ? "Change room" : "Zmień salę")
                    </button>
                </div>
            }
        </div>
    </div>
}

@if (IsNewsModalOpen && SelectedAnnouncement != null)
