    private async Task ExportAllToCalendar()
    {
        var prepared = ScheduleService.GetPreparedData();
        if (!prepared.Any())
        {
            Layout?.ShowToast(CurrentLang == "en-US" ? "No classes to export." : "Brak zajęć do wyeksportowania.", MainLayout.ToastType.Warning);
            return;
        }

        try
        {
            await CalendarExportService.ExportToSystemCalendarAsync(prepared, includeAlarms: true);
            Layout?.ShowToast(CurrentLang == "en-US" ? "Opening Calendar..." : "Otwieranie Kalendarza...", MainLayout.ToastType.Success);
        }
        catch (Exception ex)
        {
            Layout?.ShowToast($"Błąd: {ex.Message}", MainLayout.ToastType.Error);
        }
    }

