    private bool isSyncingTerm = false;

    private void OnWeekParityChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int modeInt))
        {
            AppState.WeekParity = (WeekParityMode)modeInt;
            Layout?.ShowToast(CurrentLang == "en-US" ? "Week parity setting saved" : "Zapisano ustawienie parzystości tygodnia", MainLayout.ToastType.Success);
        }
    }

    private async Task SyncWeekInfoFromUsos()
    {
        isSyncingTerm = true;
        StateHasChanged();
        try
        {
            var result = await ScheduleService.FetchAndSyncTermFromUsosAsync(UsosApiService);
            if (!string.IsNullOrEmpty(result))
            {
                Layout?.ShowToast(CurrentLang == "en-US" ? $"Synced term: {result}" : $"Pobrano dane semestru: {result}", MainLayout.ToastType.Success);
            }
            else
            {
                Layout?.ShowToast(CurrentLang == "en-US" ? "Could not fetch semester from USOS (using local calendar)" : "Nie udało się pobrać semestru z USOS (użyto kalendarza lokalnego)", MainLayout.ToastType.Warning);
            }
        }
        catch (Exception ex)
        {
            Layout?.ShowToast($"Błąd: {ex.Message}", MainLayout.ToastType.Error);
        }
        finally
        {
            isSyncingTerm = false;
            StateHasChanged();
        }
    }

    private async Task Logout()
    {
        FirebaseService.UnsubscribeAllSubscriptions();
        await UsosAuthService.LogoutAsync();
        ProfileService.Clear();
        ScheduleService.Clear();
        AppState.Reset();
        Nav.NavigateTo("/login", true);
    }
    
    private async Task DeleteAccount()
    {
        string prompt = CurrentLang == "en-US" 
            ? "Are you sure you want to delete your account? All data, announcements and group memberships will be lost." 
            : "Czy na pewno chcesz usunąć swoje konto z bazy aplikacji? Utracisz wszystkie zapisane dane, ogłoszenia oraz przynależność do grup.";
        bool confirmed = await JS.InvokeAsync<bool>("confirm", prompt);
        if (confirmed)
        {
            string myId = ProfileService.StudentNumber;
            if (string.IsNullOrEmpty(myId)) myId = Preferences.Default.Get("user_student_number", "");
            string secondaryId = ProfileService.Id;
            if (string.IsNullOrEmpty(secondaryId)) secondaryId = Preferences.Default.Get("user_usos_id", "");

            if (!string.IsNullOrEmpty(myId) || !string.IsNullOrEmpty(secondaryId))
            {
                await FirebaseService.DeleteUserAccountAsync(myId, secondaryId);
            }
            else if (AppState.IsStarostaMode && !string.IsNullOrEmpty(AppState.GroupCode))
            {
                await FirebaseService.DeleteGroupAsync(AppState.GroupCode);
            }

            AppState.Reset();
            await Logout();
        }
    }

    public void Dispose()
    {
        AppState.OnChange -= OnAppStateChanged;
        _leaveTimer?.Stop();
        _leaveTimer?.Dispose();
        _leaveTimer = null;
    }
