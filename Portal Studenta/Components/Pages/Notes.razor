    private static async Task<string> SaveDataUriToTempFileAsync(string dataUri, string? suggestedFileName)
    {
        if (string.IsNullOrWhiteSpace(dataUri) || !dataUri.StartsWith("data:image", StringComparison.OrdinalIgnoreCase))
        {
            return "";
        }

        try
        {
            var commaIdx = dataUri.IndexOf(',');
            if (commaIdx < 0) return "";

            var header = dataUri.Substring(0, commaIdx);
            var base64 = dataUri.Substring(commaIdx + 1);
            var bytes = Convert.FromBase64String(base64);

            var ext = ".jpg";
            if (header.Contains("image/png", StringComparison.OrdinalIgnoreCase)) ext = ".png";
            else if (header.Contains("image/webp", StringComparison.OrdinalIgnoreCase)) ext = ".webp";
            else if (header.Contains("image/gif", StringComparison.OrdinalIgnoreCase)) ext = ".gif";

            var fileName = !string.IsNullOrWhiteSpace(suggestedFileName)
                ? Path.GetFileNameWithoutExtension(suggestedFileName)
                : $"zdjecie_{DateTime.Now:yyyyMMdd_HHmmss}";

            var attachmentsDir = NoteService.GetAttachmentsDirectory();
            var targetPath = Path.Combine(attachmentsDir, $"{fileName}_{Guid.NewGuid():N}{ext}");

            await File.WriteAllBytesAsync(targetPath, bytes);
            return targetPath;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Notes] SaveDataUriToTempFileAsync error: {ex.Message}");
            return "";
        }
    }

    private async Task OpenAttachmentInSystem(NoteAttachment? att)
    {
        if (att == null) return;

        try
        {
            var filePath = att.LocalPath;

            // Jeśli ścieżka lokalna jest pusta lub plik nie istnieje, sprawdź lightboxImageUri
            if (string.IsNullOrEmpty(filePath) || !File.Exists(filePath))
            {
                if (!string.IsNullOrEmpty(lightboxImageUri) && lightboxImageUri.StartsWith("data:image", StringComparison.OrdinalIgnoreCase))
                {
                    filePath = await SaveDataUriToTempFileAsync(lightboxImageUri, att.FileName);
                    if (!string.IsNullOrEmpty(filePath) && File.Exists(filePath))
                    {
                        att.LocalPath = filePath;
                    }
                }
            }

            if (string.IsNullOrEmpty(filePath) || !File.Exists(filePath))
            {
                Console.WriteLine("[Notes] OpenAttachmentInSystem: Plik załącznika nie istnieje na dysku.");
                return;
            }

            var mimeType = !string.IsNullOrEmpty(att.ContentType) ? att.ContentType : "image/jpeg";
            var fileName = !string.IsNullOrWhiteSpace(att.FileName) ? att.FileName : Path.GetFileName(filePath);

            bool opened = false;

            // Krok 1: Launcher MAUI (OpenFileRequest)
            try
            {
                opened = await Launcher.Default.OpenAsync(new OpenFileRequest
                {
                    Title = fileName,
                    File = new ReadOnlyFile(filePath, mimeType)
                });
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Notes] Launcher.OpenAsync(OpenFileRequest) failed: {ex.Message}");
            }

            // Krok 2: Launcher MAUI (file:// URI)
            if (!opened)
            {
                try
                {
                    opened = await Launcher.Default.OpenAsync(new Uri($"file://{filePath}"));
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[Notes] Launcher.OpenAsync(Uri) failed: {ex.Message}");
                }
            }

#if MACCATALYST
            // Krok 3: Natywne wywołanie /usr/bin/open na macOS (Podgląd / Preview)
            if (!opened)
            {
                try
                {
                    using var proc = System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
                    {
                        FileName = "/usr/bin/open",
                        Arguments = $"\"{filePath}\"",
                        UseShellExecute = false,
                        CreateNoWindow = true
                    });
                    opened = true;
                }
                catch (Exception pEx)
                {
                    Console.WriteLine($"[Notes] Process.Start /usr/bin/open failed: {pEx.Message}");
                }
            }
#elif WINDOWS
            // Krok 3: Natywne otwarcie pliku w domyślnym programie systemu Windows (Zdjęcia / Edge / Czytnik PDF)
            if (!opened)
            {
                try
                {
                    using var proc = System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
                    {
                        FileName = filePath,
                        UseShellExecute = true
                    });
                    opened = true;
                }
                catch (Exception pEx)
                {
                    Console.WriteLine($"[Notes] Process.Start Windows shell failed: {pEx.Message}");
                }
            }
#endif

            // Krok 4: Arkusz udostępniania systemowego (Share Sheet / Photos / Files)
            if (!opened)
            {
                try
                {
                    await Share.Default.RequestAsync(new ShareFileRequest
                    {
                        Title = fileName,
                        File = new ShareFile(filePath, mimeType)
                    });
                    opened = true;
                }
                catch (Exception shareEx)
                {
                    Console.WriteLine($"[Notes] Share.RequestAsync failed: {shareEx.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Notes] OpenAttachmentInSystem error: {ex.Message}");
        }
    }

