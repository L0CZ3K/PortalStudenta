@page "/notes"
@using Portal_Studenta.Models
@using Portal_Studenta.Services
@using System.Collections.Concurrent
@inject NoteService NoteService
@inject ScheduleService ScheduleService
@inject FirebaseService FirebaseService
@inject AppState AppState
@inject IJSRuntime JS
@implements IDisposable

<div class="notes-container @($"mobile-depth-{mobileDepth}")">
    <!-- ==================================================================== -->
    <!-- KOLUMNA 1: DRZEWO FOLDERÓW AKADEMICKICH Z USOS -->
    <!-- ==================================================================== -->
    <div class="notes-sidebar-col">
        <div class="sidebar-header">
            <h2 class="sidebar-title">
                <span>📁</span>
                <span>@(CurrentLang == "en-US" ? "Folders" : "Foldery")</span>
            </h2>
            <div style="display: flex; gap: 6px; align-items: center;">
                <button class="btn btn-sm" @onclick="SyncNotesManualAsync" title="Synchronizuj notatki z chmurą" style="background: rgba(120, 120, 128, 0.15); border-radius: 8px; padding: 4px 8px; font-size: 0.82rem; color: var(--text-main);">
                    @(isSyncingNotes ? "⏳" : "🔄")
                </button>
                @if (IsPhone)
                {
                <button class="btn btn-sm remote-cam-header-btn" @onclick="OpenPhoneTransmitModal" title="Prześlij zdjęcie z telefonu do komputera">
                    📸 Wyślij do PC
                </button>
                }
                <button class="btn btn-sm" @onclick="CreateUncategorizedNote" title="Nowa szybka notatka" style="background: rgba(120, 120, 128, 0.15); border-radius: 8px; padding: 4px 10px; font-weight: 700; color: var(--text-main);">
                    +
                </button>
            </div>
        </div>

        <div class="folders-scroll-area">

            <!-- Foldery systemowe -->
            <div class="folder-section-label">@(CurrentLang == "en-US" ? "Quick Access" : "Szybki dostęp")</div>
            @foreach (var sysFolder in folderHierarchy.Where(f => f.FolderType is NoteFolderType.All or NoteFolderType.Pinned or NoteFolderType.BetweenDevices or NoteFolderType.LocalOnly or NoteFolderType.Shared or NoteFolderType.Uncategorized or NoteFolderType.Trash))
            {
                <div class="folder-item @(selectedFolder?.Id == sysFolder.Id ? "active" : "")" @onclick="() => SelectFolder(sysFolder)">
                    <div class="folder-info">
                        <span>@sysFolder.Icon</span>
                        <span class="folder-name">@sysFolder.Name</span>
                    </div>
                    <span class="folder-count">@sysFolder.NoteCount</span>
                </div>
            }

            <!-- Foldery z przedmiotów USOS -->
            <div class="folder-section-label">@(CurrentLang == "en-US" ? "USOS Timetable Courses" : "Przedmioty z USOS")</div>
            @if (!folderHierarchy.Any(f => f.FolderType == NoteFolderType.Subject))
            {
                <div style="padding: 10px; font-size: 0.8rem; color: var(--text-muted); text-align: center;">
                    @(CurrentLang == "en-US" ? "No courses loaded from USOS." : "Brak przedmiotów z USOS.")
                </div>
            }
            @foreach (var subj in folderHierarchy.Where(f => f.FolderType == NoteFolderType.Subject))
            {
                <div class="nested-folder-group">
                    <div class="folder-item @(selectedFolder?.Id == subj.Id ? "active" : "")" @onclick="() => SelectFolder(subj)">
                        <div class="folder-info">
                            <span class="collapse-chevron" @onclick:stopPropagation="true" @onclick="() => ToggleFolderExpanded(subj)">
                                @(subj.IsExpanded ? "▼" : "▶")
                            </span>
                            <span>@subj.Icon</span>
                            <span class="folder-name">@subj.Name</span>
                        </div>
                        <span class="folder-count">@subj.NoteCount</span>
                    </div>

                    @if (subj.IsExpanded)
                    {
                        @foreach (var typeNode in subj.Children)
                        {
                            <div class="folder-item nested-indent-1 @(selectedFolder?.Id == typeNode.Id ? "active" : "")" @onclick="() => SelectFolder(typeNode)">
                                <div class="folder-info">
                                    @if (typeNode.Children.Any())
                                    {
                                        <span class="collapse-chevron" @onclick:stopPropagation="true" @onclick="() => ToggleFolderExpanded(typeNode)">
                                            @(typeNode.IsExpanded ? "▼" : "▶")
                                        </span>
                                    }
                                    <span>@typeNode.Icon</span>
                                    <span class="folder-name">@typeNode.Name</span>
                                </div>
                                <span class="folder-count">@typeNode.NoteCount</span>
                            </div>

                            @if (typeNode.IsExpanded && typeNode.Children.Any())
                            {
                                @foreach (var grpNode in typeNode.Children)
                                {
                                    <div class="folder-item nested-indent-2 @(selectedFolder?.Id == grpNode.Id ? "active" : "")" @onclick="() => SelectFolder(grpNode)">
                                        <div class="folder-info">
                                            <span>@grpNode.Icon</span>
                                            <span class="folder-name">@grpNode.Name</span>
                                        </div>
                                        <span class="folder-count">@grpNode.NoteCount</span>
                                    </div>
                                }
                            }
                        }
                    }
                </div>
            }
        </div>
    </div>

    <!-- ==================================================================== -->
    <!-- KOLUMNA 2: LISTA NOTATEK -->
    <!-- ==================================================================== -->
    <div class="notes-list-col">
        <div class="list-header">
            <div class="list-header-row">
                <div style="display: flex; align-items: center; gap: 8px; overflow: hidden;">
                    <button class="notes-mobile-back-btn" @onclick="GoBackToFolders" title='@(CurrentLang == "en-US" ? "Back to folders" : "Powrót do folderów")'>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 17px; height: 17px;">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                        <span>@(CurrentLang == "en-US" ? "Folders" : "Foldery")</span>
                    </button>
                    <h3 class="list-title">@(selectedFolder?.Name ?? (CurrentLang == "en-US" ? "All Notes" : "Wszystkie notatki"))</h3>
                </div>
                <div style="display: flex; align-items: center; gap: 5px; flex-shrink: 0;">
                    @if (selectedFolder?.FolderType == NoteFolderType.Trash)
                    {
                        @if (FilteredNotes.Any())
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="EmptyTrashFolderAsync" title="Trwale opróżnij kosz" style="border-radius: 8px; font-weight: 600; padding: 4px 8px; font-size: 0.78rem;">
                                🔥 @(CurrentLang == "en-US" ? "Empty" : "Opróżnij")
                            </button>
                        }
                    }
                    else
                    {
                        @if (FilteredNotes.Any())
                        {
                            <button class="btn btn-sm" @onclick="ExportSubjectScriptPdfAsync" disabled="@isExportingSubjectPdf" title="Eksportuj wszystkie notatki z tego folderu/przedmiotu jako jeden skrypt PDF ze spisem treści" style="background: rgba(120, 120, 128, 0.14); border: 1px solid var(--border-color); color: var(--text-main); border-radius: 8px; font-weight: 600; padding: 4px 8px; font-size: 0.78rem;">
                                @(isExportingSubjectPdf ? "⏳" : "📚 PDF")
                            </button>
                        }
                        <button class="btn btn-sm btn-primary" @onclick="CreateNewNoteInSelectedFolder" title="Dodaj notatkę do tego folderu" style="border-radius: 8px; font-weight: 600; padding: 4px 10px; font-size: 0.82rem;">
                            + @(CurrentLang == "en-US" ? "New" : "Nowa")
                        </button>
                    }
                </div>
            </div>
            <div class="search-input-wrapper">
                <span class="search-icon">🔍</span>
                <input type="text" placeholder='@(CurrentLang == "en-US" ? "Search notes..." : "Szukaj notatek...")' @bind="searchQuery" @bind:event="oninput" />
            </div>
        </div>

        <div class="notes-cards-scroll">
            @if (!FilteredNotes.Any())
            {
                <div style="padding: 30px 10px; text-align: center; color: var(--text-muted); font-size: 0.85rem;">
                    @(string.IsNullOrWhiteSpace(searchQuery)
                        ? (CurrentLang == "en-US" ? "No notes in this folder." : "Brak notatek w tym folderze.")
                        : (CurrentLang == "en-US" ? "No matching notes found." : "Brak pasujących notatek."))
                </div>
            }
            @foreach (var note in FilteredNotes)
            {
                <div class="note-card @(activeNote?.Id == note.Id ? "active" : "")" @onclick="() => SelectNote(note)">
                    <div class="note-card-title-row">
                        <h4 class="note-card-title">
                            @(string.IsNullOrWhiteSpace(note.Title) ? (CurrentLang == "en-US" ? "New Note" : "Nowa notatka") : note.Title)
                        </h4>
                        @if (note.IsPinned)
                        {
                            <span style="font-size: 0.8rem;" title="Przypięta">📌</span>
                        }
                        @if (note.SharingMode == NoteSharingMode.SharedWithAll && note.IsReadOnlyForGroup)
                        {
                            <span style="font-size: 0.78rem;" title="Tylko do odczytu dla grupy">🛡️</span>
                        }
                    </div>
                    <div class="note-card-snippet">
                        @GetCleanSnippet(note.Content)
                    </div>
                    <div class="note-card-footer">
                        <span>@FormatNoteDate(note.UpdatedAt)</span>
                        <div class="note-badges-wrap">
                            @if (!string.IsNullOrWhiteSpace(note.Subject))
                            {
                                <span class="note-badge-pill">@FormatShortBadge(note.Subject, note.LessonType, note.GroupName)</span>
                            }
                            @if (note.SharingMode == NoteSharingMode.LocalOnly)
                            {
                                <span class="note-badge-pill" title="Lokalnie na tym urządzeniu" style="color: var(--text-muted);">🔒</span>
                            }
                            else if (note.SharingMode == NoteSharingMode.BetweenDevices)
                            {
                                <span class="note-badge-pill" title="Synchronizowana między Twoimi urządzeniami" style="color: #0284c7;">📱💻</span>
                            }
                            else if (note.SharingMode == NoteSharingMode.SharedWithAll || note.IsSharedWithGroup)
                            {
                                <span class="note-badge-pill" title="Udostępniona wszystkim w grupie" style="color: var(--primary-color);">👥</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ==================================================================== -->
    <!-- KOLUMNA 3: ZAAWANSOWANY EDYTOR NOTATEK WYSIWYG -->
    <!-- ==================================================================== -->
    <div class="note-editor-col">
        @if (activeNote != null)
        {
            var canEditActive = CanModifyNote(activeNote) && !activeNote.IsDeleted;
            <div class="editor-toolbar">
                <div class="editor-nav-bar">
                    <button class="notes-mobile-back-btn" @onclick="GoBackToNotesList" title='@(CurrentLang == "en-US" ? "Back to notes" : "Powrót do notatek")'>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 17px; height: 17px;">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                        <span>@(CurrentLang == "en-US" ? "Notes" : "Notatki")</span>
                    </button>

                    <div class="editor-header-actions">
                        @if (!activeNote.IsDeleted)
                        {
                            <div class="sharing-mode-selector" title="Zakres synchronizacji notatki">
                                <button type="button" class="sharing-pill local @(activeNote.SharingMode == NoteSharingMode.LocalOnly ? "active" : "")"
                                        disabled="@(!canEditActive)"
                                        @onclick="() => SetSharingModeAsync(NoteSharingMode.LocalOnly)"
                                        title="Lokalnie: Notatka zapisana wyłącznie na tym urządzeniu (SQLite)">
                                    🔒 <span class="sharing-pill-label">Lokalnie</span>
                                </button>
                                <button type="button" class="sharing-pill devices @(activeNote.SharingMode == NoteSharingMode.BetweenDevices ? "active" : "")"
                                        disabled="@(!canEditActive)"
                                        @onclick="() => SetSharingModeAsync(NoteSharingMode.BetweenDevices)"
                                        title="Między urządzeniami: Prywatna chmura – dostępna na Twoim komputerze i telefonie">
                                    📱💻 <span class="sharing-pill-label">Urządzenia</span>
                                </button>
                                <button type="button" class="sharing-pill all @(activeNote.SharingMode == NoteSharingMode.SharedWithAll ? "active" : "")"
                                        disabled="@(!canEditActive)"
                                        @onclick="() => SetSharingModeAsync(NoteSharingMode.SharedWithAll)"
                                        title="Udostępnij wszystkim: Widoczna dla wszystkich studentów w grupie">
                                    👥 <span class="sharing-pill-label">Wszyscy</span>
                                </button>
                            </div>
                            @if (activeNote.SharingMode == NoteSharingMode.SharedWithAll && CanModifyNote(activeNote))
                            {
                                <button type="button" class="toolbar-tool-btn @(activeNote.IsReadOnlyForGroup ? "active" : "")"
                                        @onclick="ToggleGroupReadOnlyAsync"
                                        title="Zablokuj edycję i usuwanie tej notatki przez innych członków grupy (Tylko do odczytu dla grupy)">
                                    🛡️ <span class="sharing-pill-label">@(activeNote.IsReadOnlyForGroup ? "Zablokowana" : "Ochrona")</span>
                                </button>
                            }
                        }
                        <button type="button" class="toolbar-tool-btn" @onclick="ExportActiveNoteToPdfAsync" title="Eksportuj notatkę do PDF" disabled="@isExportingPdf">
                            @(isExportingPdf ? "⏳ PDF..." : "📄 PDF")
                        </button>
                        @if (!activeNote.IsDeleted)
                        {
                            <button class="toolbar-tool-btn @(activeNote.IsPinned ? "active" : "")" @onclick="TogglePinActiveNote" title="Przypnij notatkę">
                                📌
                            </button>
                        }
                        @if (canEditActive || activeNote.IsDeleted)
                        {
                            <button class="toolbar-tool-btn" @onclick="DeleteActiveNote" title="@(activeNote.IsDeleted ? "Usuń trwale" : "Przenieś do kosza (7 dni)")" style="color: var(--danger-color);">
                                🗑️
                            </button>
                        }
                        <button class="notes-mobile-done-btn" @onclick="GoBackToNotesList" title='@(CurrentLang == "en-US" ? "Done" : "Gotowe")'>
                            @(CurrentLang == "en-US" ? "Done" : "Gotowe")
                        </button>
                    </div>
                </div>

                @if (canEditActive)
                {
                    <div class="editor-tools-scroll">
                        <!-- Style nagłówków (Title, Subtitle, Body) -->
                        <button type="button" class="toolbar-tool-btn" onmousedown="event.preventDefault(); window.notesEditor.setHeading('H1');" title="Tytuł duży (H1)">
                            <b>H1</b>
                        </button>
                        <button type="button" class="toolbar-tool-btn" onmousedown="event.preventDefault(); window.notesEditor.setHeading('H2');" title="Nagłówek (H2)">
                            <b>H2</b>
                        </button>
                        <button type="button" class="toolbar-tool-btn" onmousedown="event.preventDefault(); window.notesEditor.setHeading('P');" title="Zwykły tekst (Aa)">
                            Aa
                        </button>

                        <div class="toolbar-separator"></div>

                        <!-- Podstawowe formatowanie inline -->
                        <button type="button" id="btn-format-bold" class="toolbar-tool-btn" onmousedown="event.preventDefault(); window.notesEditor.exec('bold');" title="Pogrubienie (Cmd+B)">
                            <b>B</b>
                        </button>
                        <button type="button" id="btn-format-italic" class="toolbar-tool-btn" onmousedown="event.preventDefault(); window.notesEditor.exec('italic');" title="Kursywa (Cmd+I)">
                            <i>I</i>
                        </button>
                        <button type="button" id="btn-format-underline" class="toolbar-tool-btn" onmousedown="event.preventDefault(); window.notesEditor.exec('underline');" title="Podkreślenie (Cmd+U)">
                            <u>U</u>
                        </button>
                        <button type="button" id="btn-format-strike" class="toolbar-tool-btn" onmousedown="event.preventDefault(); window.notesEditor.exec('strikeThrough');" title="Przekreślenie">
                            <s>S</s>
                        </button>
                        <button type="button" class="toolbar-tool-btn" onmousedown="event.preventDefault(); window.notesEditor.toggleHighlightColor();" title="Zakreślacz tekstu">
                            🖊️
                        </button>

                        <div class="toolbar-separator"></div>

                        <!-- Listy i checklisty -->
                        <button type="button" class="toolbar-tool-btn" onmousedown="event.preventDefault(); window.notesEditor.insertChecklist();" title="Lista zadań / checklista">
                            🔘
                        </button>
                        <button type="button" class="toolbar-tool-btn" onmousedown="event.preventDefault(); window.notesEditor.exec('insertUnorderedList');" title="Lista punktowana">
                            •
                        </button>
                        <button type="button" class="toolbar-tool-btn" onmousedown="event.preventDefault(); window.notesEditor.exec('insertOrderedList');" title="Lista numerowana">
                            1.
                        </button>

                        <div class="toolbar-separator"></div>

                        <!-- Blok kodu IDE z pojedynczym przyciskiem </> -->
                        <button type="button" class="toolbar-tool-btn" onmousedown="event.preventDefault(); window.notesEditor.insertCodeBlock('C#');" title="Wstaw blok kodu (&lt;/&gt;)">
                            <b>&lt;/&gt;</b>
                        </button>

                        <div class="toolbar-separator"></div>

                        <!-- Załączniki i aparat -->
                        <button type="button" class="toolbar-tool-btn" onmousedown="window.notesEditor.saveSelection();" @onclick="CaptureWhiteboardPhotoAsync" title="Zrób zdjęcie tablicy aparatem">
                            📷
                        </button>
                        <button type="button" class="toolbar-tool-btn" onmousedown="window.notesEditor.saveSelection();" @onclick="PickWhiteboardPhotoAsync" title="Dodaj zdjęcie z galerii">
                            🖼️
                        </button>
                        <button type="button" class="toolbar-tool-btn" onmousedown="window.notesEditor.saveSelection();" @onclick="PickDocumentAsync" title="Załącz dokument PDF">
                            📎
                        </button>
                        <button type="button" class="toolbar-tool-btn desktop-only-btn" onmousedown="window.notesEditor.saveSelection();" @onclick="StartRemoteCameraSessionAsync" title="Aparat zdalny: Zrób zdjęcie telefonem (Skrót: Cmd+Shift+C)">
                            📱 Z telefonu
                        </button>
                    </div>
                }
            </div>

            <div class="editor-body-area">
                @if (activeNote.IsDeleted)
                {
                    <div class="note-status-banner trash">
                        <span>🗑️ Ta notatka znajduje się w Koszu (zostanie automatycznie usunięta po 7 dniach).</span>
                        <div style="display: flex; gap: 8px; flex-shrink: 0;">
                            <button type="button" class="btn btn-sm btn-outline-light" @onclick="RestoreActiveNoteAsync" style="border-radius: 7px; font-weight: 700; font-size: 0.78rem; padding: 3px 10px;">
                                ♻️ Przywróć
                            </button>
                            <button type="button" class="btn btn-sm btn-danger" @onclick="PermanentDeleteActiveNoteAsync" style="border-radius: 7px; font-weight: 700; font-size: 0.78rem; padding: 3px 10px;">
                                🔥 Usuń trwale
                            </button>
                        </div>
                    </div>
                }
                else if (!canEditActive)
                {
                    <div class="note-status-banner readonly">
                        <span>🛡️ Tryb tylko do odczytu — notatka udostępniona przez autora (@activeNote.Author) z ochroną przed edycją.</span>
                    </div>
                }

                <input type="text" class="note-title-input" placeholder='@(CurrentLang == "en-US" ? "Note Title" : "Tytuł notatki")'
                       readonly="@(!canEditActive)"
                       @bind="activeNote.Title" @bind:event="oninput" @bind:after="OnNoteTitleChanged" />

                <div class="note-meta-breadcrumbs">
                    <span>📅 @activeNote.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                    <span class="breadcrumb-tag">👤 @activeNote.Author</span>
                    @if (!string.IsNullOrWhiteSpace(activeNote.Subject))
                    {
                        <span class="breadcrumb-tag">📚 @activeNote.Subject</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(activeNote.LessonType))
                    {
                        <span class="breadcrumb-tag">@activeNote.LessonType</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(activeNote.GroupName))
                    {
                        <span class="breadcrumb-tag">👥 @activeNote.GroupName</span>
                    }
                </div>

                <!-- PASEK ZAŁĄCZONYCH DOKUMENTÓW (ZDJĘCIA SĄ BEZPOŚREDNIO W TEKŚCIE) -->
                @{
                    var documentAttachments = activeNote.Attachments
                        .Where(att => !(att.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) ||
                                        att.FileName.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
                                        att.FileName.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
                                        att.FileName.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
                                        att.FileName.EndsWith(".webp", StringComparison.OrdinalIgnoreCase)))
                        .ToList();
                }
                @if (documentAttachments.Any())
                {
                    <div class="note-attachments-strip">
                        @foreach (var att in documentAttachments)
                        {
                            <div class="attachment-chip" @onclick="() => OnAttachmentClick(att)">
                                <span class="attachment-chip-icon">📄</span>
                                <div class="attachment-chip-details">
                                    <span class="attachment-chip-name" title="@att.FileName">@att.FileName</span>
                                    <span class="attachment-chip-size">@WhiteboardImageOptimizer.FormatBytes(att.SizeBytes)</span>
                                </div>
                                @if (canEditActive)
                                {
                                    <button type="button" class="attachment-chip-delete" @onclick:stopPropagation="true" @onclick="() => DeleteAttachment(att)" title="Usuń załącznik">✕</button>
                                }
                            </div>
                        }
                    </div>
                }

                <!-- GŁÓWNY EDYTOR WYSIWYG -->
                <div @ref="editorElementRef"
                     class="notes-rich-editor"
                     contenteditable="@(canEditActive ? "true" : "false")"
                     spellcheck="true"
                     data-placeholder='@(CurrentLang == "en-US" ? "Start typing your note..." : "Zacznij pisać notatkę...")'>
                </div>
            </div>
        }
        else
        {
            <div class="empty-editor-placeholder">
                <span class="empty-editor-icon">📝</span>
                <h3 style="margin: 0; font-size: 1.2rem; font-weight: 700;">@(CurrentLang == "en-US" ? "No Note Selected" : "Nie wybrano notatki")</h3>
                <p style="margin: 0; max-width: 320px; font-size: 0.88rem;">
                    @(CurrentLang == "en-US"
                        ? "Select a note from the list or create a new one in the current folder."
                        : "Wybierz notatkę z listy lub utwórz nową w wybranym folderze.")
                </p>
                @if (selectedFolder?.FolderType != NoteFolderType.Trash)
                {
                    <button class="btn btn-primary" @onclick="CreateNewNoteInSelectedFolder" style="border-radius: 9px; font-weight: 600; padding: 6px 16px; margin-top: 8px;">
                        + @(CurrentLang == "en-US" ? "Create Note" : "Utwórz notatkę")
                    </button>
                }
            </div>
        }
    </div>

    <!-- LIGHTBOX TABLICY -->
    @if (activeLightboxAttachment != null)
    {
        <div class="image-lightbox-overlay" @onclick="CloseLightbox">
            <div class="image-lightbox-dialog" @onclick:stopPropagation="true">
                <div class="image-lightbox-header">
                    <div class="lightbox-title-wrap">
                        <span class="lightbox-title">@activeLightboxAttachment.FileName</span>
                        @if (activeLightboxAttachment.SizeBytes > 0)
                        {
                            <span class="lightbox-size">@WhiteboardImageOptimizer.FormatBytes(activeLightboxAttachment.SizeBytes)</span>
                        }
                    </div>
                    <div class="lightbox-actions">
                        <button type="button" class="lightbox-system-btn" @onclick="() => OpenAttachmentInSystem(activeLightboxAttachment)"
                                title='@(CurrentLang == "en-US" ? "Open in default system app (Preview / Photos)" : "Otwórz w domyślnej aplikacji systemowej (np. Podgląd / Zdjęcia)")'>
                            <span>↗️</span>
                            <span>@(CurrentLang == "en-US" ? "Open in System" : "Otwórz w systemie")</span>
                        </button>
