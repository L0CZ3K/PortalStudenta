            transmitStatusMessage = "Wybieranie zdjęcia z galerii...";

            FileResult? photo = null;
            if (DeviceInfo.Current.Platform == DevicePlatform.MacCatalyst || DeviceInfo.Current.Idiom == DeviceIdiom.Desktop)
            {
