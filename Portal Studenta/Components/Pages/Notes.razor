    private async Task SetSharingModeAsync(NoteSharingMode mode)
    {
        if (activeNote == null) return;
        var previousMode = activeNote.SharingMode;
        activeNote.SharingMode = mode;
        activeNote.UpdatedAt = DateTime.Now;
        if (mode == NoteSharingMode.SharedWithAll)
        {
            activeNote.SharedGroupCode = AppState.GroupCode;
        }

        await NoteService.SaveNoteAsync(activeNote);

        var album = GetCurrentStudentAlbum();
        var group = AppState.GroupCode;

        _ = Task.Run(async () =>
        {
            try
            {
                if (mode == NoteSharingMode.LocalOnly)
                {
                    if (!string.IsNullOrWhiteSpace(album))
                        await FirebaseService.DeleteNoteFromCloudAsync(album, activeNote.Id);
                    if (!string.IsNullOrWhiteSpace(group))
                        await FirebaseService.UnshareNoteFromGroupLobbyAsync(group, activeNote.Id);
                }
                else if (mode == NoteSharingMode.BetweenDevices)
                {
                    if (!string.IsNullOrWhiteSpace(album))
                        await FirebaseService.SyncNoteToCloudAsync(album, activeNote);
                    if (!string.IsNullOrWhiteSpace(group) && previousMode == NoteSharingMode.SharedWithAll)
                        await FirebaseService.UnshareNoteFromGroupLobbyAsync(group, activeNote.Id);
                }
                else if (mode == NoteSharingMode.SharedWithAll)
                {
                    if (!string.IsNullOrWhiteSpace(album))
                        await FirebaseService.SyncNoteToCloudAsync(album, activeNote);
                    if (!string.IsNullOrWhiteSpace(group))
                        await FirebaseService.ShareNoteToGroupLobbyAsync(group, activeNote);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Notes] SetSharingModeAsync cloud error: {ex.Message}");
            }
        });

        RefreshHierarchy();
        StateHasChanged();
    }

    private void SyncNoteIfCloudEnabled(Note note)
    {
        if (note.SharingMode == NoteSharingMode.LocalOnly) return;
        var album = GetCurrentStudentAlbum();
        var group = AppState.GroupCode;
        _ = Task.Run(async () =>
        {
            try
            {
                if (!string.IsNullOrWhiteSpace(album))
                    await FirebaseService.SyncNoteToCloudAsync(album, note);
                if (note.SharingMode == NoteSharingMode.SharedWithAll && !string.IsNullOrWhiteSpace(group))
                    await FirebaseService.ShareNoteToGroupLobbyAsync(group, note);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Notes] SyncNoteIfCloudEnabled error: {ex.Message}");
            }
        });
    }

