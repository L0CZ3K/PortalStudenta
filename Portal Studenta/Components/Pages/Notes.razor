    private async Task CheckPcStatusAsync()
    {
        try
        {
            var album = GetCurrentStudentAlbum();
            var session = await FirebaseService.GetPermanentRemoteCameraSessionAsync(album);

            if (session == null || session.Status == "offline")
            {
                isTargetPcOnline = false;
                isTargetPcListening = false;
                targetPcConnectionMode = "offline";
                remoteTargetNoteTitle = "";
                remoteTargetLocalEndpoint = "";
                remoteTargetAuthToken = "";
            }
            else
            {
                remoteTargetNoteTitle = !string.IsNullOrWhiteSpace(session.NoteTitle) ? session.NoteTitle : "Aktywna notatka na PC";
                remoteTargetLocalEndpoint = session.LocalEndpoint ?? "";
                remoteTargetAuthToken = session.AuthToken ?? "";

                // Sprawdź czy heartbeat z Firebase nie jest przestarzały (np. Mac uśpiony/wyłączony > 25 sekund)
                var isHeartbeatFresh = (DateTime.UtcNow - session.UpdatedAt) <= TimeSpan.FromSeconds(25);

                // 1. Sprawdź Wi-Fi ze statusem nasłuchiwania
                bool wifiAlive = false;
                bool wifiListening = false;
                if (!string.IsNullOrEmpty(remoteTargetLocalEndpoint))
                {
                    (wifiAlive, wifiListening) = await LocalNetworkCameraServer.PingWithStatusAsync(remoteTargetLocalEndpoint);
                }

                if (wifiAlive)
                {
                    isTargetPcOnline = true;
                    targetPcConnectionMode = "wifi";
                    isTargetPcListening = wifiListening || (session.Status == "ready" && session.IsListening);
                }
                else if (isHeartbeatFresh)
                {
                    isTargetPcOnline = true;
                    targetPcConnectionMode = "cloud";
                    isTargetPcListening = session.Status == "ready" && session.IsListening;
                }
                else
                {
                    isTargetPcOnline = false;
                    isTargetPcListening = false;
                    targetPcConnectionMode = "offline";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Notes] CheckPcStatusAsync error: {ex.Message}");
            isTargetPcOnline = false;
            isTargetPcListening = false;
            targetPcConnectionMode = "offline";
        }
        finally
        {
            isCheckingPcStatus = false;
            StateHasChanged();
        }
    }

    private async Task PickAndTransmitFromGalleryAsync()
    {
        if (!isTargetPcListening)
        {
            transmitStatusMessage = "Kliknij najpierw «Z telefonu» na komputerze.";
            StateHasChanged();
            return;
        }

        try
        {
            isTransmittingPhoto = true;
            transmitStatusMessage = "Wybieranie zdjęcia z galerii...";

            FileResult? photo = null;
            if (DeviceInfo.Current.Platform == DevicePlatform.MacCatalyst || DeviceInfo.Current.Idiom == DeviceIdiom.Desktop)
            {
                photo = await FilePicker.Default.PickAsync(new PickOptions
                {
                    PickerTitle = CurrentLang == "en-US" ? "Select photo to transmit" : "Wybierz zdjęcie do przesłania",
                    FileTypes = FilePickerFileType.Images
                });
            }
            else
            {
                photo = await MainThread.InvokeOnMainThreadAsync(async () =>
                {
                    return await PickSinglePhotoAsync();
                });
            }

            if (photo == null)
            {
                isTransmittingPhoto = false;
                transmitStatusMessage = "Anulowano wybór zdjęcia.";
                return;
            }

            await ProcessAndUploadTransmittedPhotoAsync(photo);
        }
        catch (Exception ex) when (ex is OperationCanceledException or TaskCanceledException)
        {
            transmitStatusMessage = "Anulowano wybór zdjęcia.";
        }
        catch (Exception ex)
        {
            transmitStatusMessage = $"Błąd: {ex.Message}";
        }
        finally
        {
            isTransmittingPhoto = false;
            StateHasChanged();
        }
    }

    private async Task TransmitPhotoFromCurrentDeviceAsync()
    {
        if (!isTargetPcListening)
        {
            transmitStatusMessage = "Kliknij najpierw «Z telefonu» na komputerze.";
            StateHasChanged();
            return;
        }

        try
        {
            isTransmittingPhoto = true;
            transmitStatusMessage = "Otwieranie aparatu...";

            FileResult? photo = null;

            if (DeviceInfo.Current.Platform == DevicePlatform.MacCatalyst || DeviceInfo.Current.Idiom == DeviceIdiom.Desktop)
            {
                photo = await FilePicker.Default.PickAsync(new PickOptions
                {
                    PickerTitle = CurrentLang == "en-US" ? "Select whiteboard photo to transmit" : "Wybierz zdjęcie tablicy do przesłania",
                    FileTypes = FilePickerFileType.Images
                });
            }
            else
            {
                photo = await MainThread.InvokeOnMainThreadAsync(async () =>
                {
                    var status = await Permissions.CheckStatusAsync<Permissions.Camera>();
                    if (status != PermissionStatus.Granted)
                    {
                        status = await Permissions.RequestAsync<Permissions.Camera>();
                    }

                    if (status == PermissionStatus.Granted && MediaPicker.Default.IsCaptureSupported)
                    {
                        isCameraPermissionDenied = false;
                        return await MediaPicker.Default.CapturePhotoAsync();
                    }

                    if (status != PermissionStatus.Granted)
                    {
                        isCameraPermissionDenied = true;
                        transmitStatusMessage = CurrentLang == "en-US"
                            ? "Camera permission denied. Tap 'Open Settings' below."
                            : "Brak uprawnień do aparatu. Kliknij poniżej, aby otworzyć Ustawienia.";
                        await InvokeAsync(StateHasChanged);
                        return null;
                    }

                    return await PickSinglePhotoAsync();
                });
            }

            if (photo == null)
            {
                isTransmittingPhoto = false;
                if (!isCameraPermissionDenied)
                {
                    transmitStatusMessage = "Anulowano robienie zdjęcia.";
                }
                return;
            }

            await ProcessAndUploadTransmittedPhotoAsync(photo);
        }
        catch (Exception ex) when (ex is OperationCanceledException or TaskCanceledException)
        {
            transmitStatusMessage = "Anulowano robienie zdjęcia.";
        }
        catch (Exception ex)
        {
            transmitStatusMessage = $"Błąd: {ex.Message}";
        }
        finally
        {
            isTransmittingPhoto = false;
            StateHasChanged();
        }
    }

    private async Task ProcessAndUploadTransmittedPhotoAsync(FileResult photo)
    {
        isTransmittingPhoto = true;
        transmitStatusMessage = "Przygotowywanie tablicy...";
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        var tempTarget = Path.Combine(Path.GetTempPath(), $"{Guid.NewGuid():N}.jpg");
        var tempThumb = Path.Combine(Path.GetTempPath(), $"{Guid.NewGuid():N}_thumb.jpg");

        try
        {
            // KROK 1: Bezpieczny odczyt bajtów na MainThread (na iOS odczyt strumienia z FileResult wymaga wątku UI)
            byte[] photoBytes;
            using (var rawStream = await MainThread.InvokeOnMainThreadAsync(async () => await photo.OpenReadAsync()))
            using (var ms = new MemoryStream())
            {
                await rawStream.CopyToAsync(ms);
                photoBytes = ms.ToArray();
            }

            await InvokeAsync(() =>
            {
                transmitStatusMessage = "Optymalizacja tablicy...";
                StateHasChanged();
            });

            // KROK 2: Sprzętowa optymalizacja tablicy (WhiteboardImageOptimizer)
            using (var inStream = new MemoryStream(photoBytes))
            {
                await WhiteboardImageOptimizer.OptimizeAndSaveAsync(inStream, tempTarget, tempThumb);
            }

            // KROK 3: Bezpieczne asynchroniczne przesyłanie sieciowe w tle (Task.Run)
            await Task.Run(async () =>
            {
                var bytes = await File.ReadAllBytesAsync(tempTarget);
                var base64 = Convert.ToBase64String(bytes);

                // Krok 3a: Próba przesłania bezpośrednio przez Wi-Fi (jeśli w jednej sieci)
                if (!string.IsNullOrEmpty(remoteTargetLocalEndpoint) && isTargetPcOnline && targetPcConnectionMode == "wifi")
                {
                    await InvokeAsync(() =>
                    {
                        transmitStatusMessage = "⚡ Błyskawiczne przesyłanie przez Wi-Fi...";
                        StateHasChanged();
                    });

                    var wifiSuccess = await LocalNetworkCameraServer.SendPhotoOverWifiAsync(remoteTargetLocalEndpoint, base64, "image/jpeg", remoteTargetAuthToken);
                    if (wifiSuccess)
                    {
                        await InvokeAsync(() =>
                        {
                            transmitStatusMessage = "Przesłano błyskawicznie przez Wi-Fi! ✓";
                            StateHasChanged();
                        });
                        await Task.Delay(800);
                        await InvokeAsync(() =>
                        {
                            showPhoneTransmitModal = false;
                            StateHasChanged();
                        });
                        return;
                    }
                }

                // Krok 3b: Fallback na stałą sesję w chmurze Firebase (jeśli Wi-Fi P2P niedostępne)
                await InvokeAsync(() =>
                {
                    transmitStatusMessage = "☁️ Przesyłanie przez chmurę...";
                    StateHasChanged();
                });

                var album = GetCurrentStudentAlbum();
                var success = await FirebaseService.UploadRemoteCameraPhotoAsync(album, FirebaseService.PermanentCameraSessionId, base64, "image/jpeg");

                if (success)
                {
                    await InvokeAsync(() =>
                    {
                        transmitStatusMessage = "Zdjęcie pomyślnie wysłane do komputera! ✓";
                        StateHasChanged();
                    });
                    await Task.Delay(800);
                    await InvokeAsync(() =>
                    {
                        showPhoneTransmitModal = false;
                        StateHasChanged();
                    });
                }
                else
                {
                    await InvokeAsync(() =>
                    {
                        transmitStatusMessage = "Błąd wysyłania: Upewnij się, że komputer ma otwartą aplikację.";
                        StateHasChanged();
                    });
                }
            });
        }
        catch (Exception ex)
        {
            transmitStatusMessage = $"Błąd przesyłania: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            try { if (File.Exists(tempTarget)) File.Delete(tempTarget); } catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[Notes] Temp file cleanup: {ex.Message}"); }
            try { if (File.Exists(tempThumb)) File.Delete(tempThumb); } catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[Notes] Temp thumb cleanup: {ex.Message}"); }
            isTransmittingPhoto = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static bool IsSafeAttachmentId(string? id)
    {
        return !string.IsNullOrWhiteSpace(id) && id.Length <= 80 && id.All(c => char.IsLetterOrDigit(c) || c == '-' || c == '_');
    }

    [JSInvokable]
    public async Task OnInlineImageClicked(string? attachmentId, string? imageSrc)
    {
        try
        {
            NoteAttachment? matchedAtt = null;
            if (!string.IsNullOrEmpty(attachmentId) && activeNote?.Attachments != null)
            {
                matchedAtt = activeNote.Attachments.FirstOrDefault(a => a.Id == attachmentId);
            }

            if (matchedAtt == null && activeNote?.Attachments != null && !string.IsNullOrEmpty(imageSrc))
            {
                matchedAtt = activeNote.Attachments.FirstOrDefault(a =>
                    (!string.IsNullOrEmpty(a.LocalPath) && imageSrc.Contains(Path.GetFileName(a.LocalPath), StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(a.FileName) && imageSrc.Contains(a.FileName, StringComparison.OrdinalIgnoreCase))
                );
            }

            // Self-healing: przeszukaj dysk w poszukiwaniu pliku powiązanego z attachmentId (tylko po walidacji ID)
            if (matchedAtt == null && IsSafeAttachmentId(attachmentId))
            {
                var attachmentsDir = NoteService.GetAttachmentsDirectory();
                var candidateFiles = Directory.Exists(attachmentsDir) ? Directory.GetFiles(attachmentsDir, $"*{attachmentId}*") : Array.Empty<string>();
                var candidate = candidateFiles.FirstOrDefault(f => !f.EndsWith("_thumb.jpg", StringComparison.OrdinalIgnoreCase)) ?? candidateFiles.FirstOrDefault();
                if (!string.IsNullOrEmpty(candidate) && File.Exists(candidate))
                {
                    matchedAtt = new NoteAttachment
                    {
                        Id = attachmentId!,
                        FileName = Path.GetFileName(candidate),
                        ContentType = candidate.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ? "image/png" : "image/jpeg",
                        LocalPath = candidate,
                        ThumbnailPath = candidateFiles.FirstOrDefault(f => f.EndsWith("_thumb.jpg", StringComparison.OrdinalIgnoreCase)) ?? candidate,
                        SizeBytes = new FileInfo(candidate).Length,
                        UploadedAt = File.GetCreationTimeUtc(candidate)
                    };
                    if (activeNote != null)
                    {
                        var list = activeNote.Attachments;
                        list.Add(matchedAtt);
                        activeNote.Attachments = list;
                        _ = NoteService.SaveNoteAsync(activeNote);
                    }
                }
            }

            if (matchedAtt != null)
            {
                await OnAttachmentClick(matchedAtt, imageSrc);
                return;
            }

            // Jeśli to inline data URI lub URL zewnętrzny (bez pliku na dysku)
            var finalSrc = imageSrc;
            if (string.IsNullOrEmpty(finalSrc) || !(finalSrc.StartsWith("data:image", StringComparison.OrdinalIgnoreCase) || finalSrc.StartsWith("http", StringComparison.OrdinalIgnoreCase)))
            {
                return;
            }

            lightboxImageUri = finalSrc;

            string tempFilePath = "";
            if (finalSrc.StartsWith("data:image", StringComparison.OrdinalIgnoreCase))
            {
                tempFilePath = await SaveDataUriToTempFileAsync(finalSrc, "zdjecie_notatki.jpg");
            }

            activeLightboxAttachment = new NoteAttachment
            {
                Id = IsSafeAttachmentId(attachmentId) ? attachmentId! : Guid.NewGuid().ToString("N"),
                FileName = "Zdjęcie tablicy",
                ContentType = "image/jpeg",
                LocalPath = tempFilePath,
                SizeBytes = !string.IsNullOrEmpty(tempFilePath) && File.Exists(tempFilePath) ? new FileInfo(tempFilePath).Length : 0
            };

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Notes] OnInlineImageClicked error: {ex.Message}");
        }
    }

