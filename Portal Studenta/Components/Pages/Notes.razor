@code {
    private string CurrentLang = "pl-PL";
    private List<NoteFolderNode> folderHierarchy = new();
    private NoteFolderNode? selectedFolder;
    private Note? activeNote;
    private string searchQuery = "";
    private int mobileDepth = 0; // 0 = Folders, 1 = NotesList, 2 = Editor

    private ElementReference editorElementRef;
    private DotNetObjectReference<Notes>? dotNetHelper;
    private bool isJsInitialized = false;
    private Guid? lastLoadedNoteId = null;

    private readonly ConcurrentDictionary<string, string> _thumbnailCache = new();
    private CancellationTokenSource? _titleDebounceCts;
    private NoteAttachment? activeLightboxAttachment;
    private string lightboxImageUri = "";

    private bool showRemoteCameraModal = false;
    private bool isCameraWaiting = false;
    private bool isSyncingNotes = false;
    private System.Timers.Timer? cameraPollTimer;
    private System.Timers.Timer? cloudSyncTimer;

    private bool showPhoneTransmitModal = false;
    private string transmitStatusMessage = "";
    private bool isTransmittingPhoto = false;
    private bool isTargetPcOnline = false;
    private bool isTargetPcListening = false;
    private bool isCheckingPcStatus = false;
    private string targetPcConnectionMode = "offline"; // "wifi", "cloud", "offline"
    private System.Timers.Timer? pcHeartbeatTimer;
    private System.Timers.Timer? phoneStatusPollTimer;

    private bool isExportingSubjectPdf = false;

    private bool CanModifyNote(Note? note)
    {
        return NoteService.CanUserModifyNote(
            note,
            GetCurrentStudentAlbum(),
            AppState.UserName,
            AppState.CanManageSchedule);
    }

    private IEnumerable<Note> FilteredNotes
    {
        get
        {
            if (selectedFolder?.FolderType == NoteFolderType.Trash)
            {
                var trashed = NoteService.GetTrashedNotes();
                if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    var q = searchQuery.Trim();
                    trashed = trashed.Where(n =>
                        (n.Title != null && n.Title.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                        (n.Content != null && n.Content.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                        (n.Subject != null && n.Subject.Contains(q, StringComparison.OrdinalIgnoreCase))
                    ).ToList();
                }
                return trashed;
            }

            var notes = NoteService.GetAllNotes();

            // Filtr wg folderu
            if (selectedFolder != null)
            {
                notes = selectedFolder.FolderType switch
                {
                    NoteFolderType.All => notes,
                    NoteFolderType.Pinned => notes.Where(n => n.IsPinned).ToList(),
                    NoteFolderType.BetweenDevices => notes.Where(n => n.SharingMode == NoteSharingMode.BetweenDevices).ToList(),
                    NoteFolderType.LocalOnly => notes.Where(n => n.SharingMode == NoteSharingMode.LocalOnly).ToList(),
                    NoteFolderType.Shared => notes.Where(n => n.SharingMode == NoteSharingMode.SharedWithAll || n.IsSharedWithGroup).ToList(),
                    NoteFolderType.Uncategorized => notes.Where(n => string.IsNullOrWhiteSpace(n.Subject)).ToList(),
                    NoteFolderType.Subject => notes.Where(n => string.Equals(n.Subject, selectedFolder.Subject, StringComparison.OrdinalIgnoreCase)).ToList(),
                    NoteFolderType.LessonType => notes.Where(n =>
                        string.Equals(n.Subject, selectedFolder.Subject, StringComparison.OrdinalIgnoreCase) &&
                        string.Equals(n.LessonType, selectedFolder.LessonType, StringComparison.OrdinalIgnoreCase)).ToList(),
                    NoteFolderType.Group => notes.Where(n =>
                        string.Equals(n.Subject, selectedFolder.Subject, StringComparison.OrdinalIgnoreCase) &&
                        string.Equals(n.LessonType, selectedFolder.LessonType, StringComparison.OrdinalIgnoreCase) &&
                        string.Equals(n.GroupName, selectedFolder.GroupName, StringComparison.OrdinalIgnoreCase)).ToList(),
                    _ => notes
                };
            }

            // Filtr wg wyszukiwarki
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.Trim();
                notes = notes.Where(n =>
                    (n.Title != null && n.Title.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (n.Content != null && n.Content.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (n.Subject != null && n.Subject.Contains(q, StringComparison.OrdinalIgnoreCase))
                ).ToList();
            }

            return notes;
        }
    }

    protected override void OnInitialized()
    {
        CurrentLang = AppState.Language;
        AppState.OnChange += OnAppStateChanged;
        NoteService.OnNotesChanged += OnNotesServiceChanged;
        ScheduleService.OnScheduleLoaded += OnScheduleServiceLoaded;

        dotNetHelper = DotNetObjectReference.Create(this);

        RefreshHierarchy();
        SelectInitialFolder();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (IsDesktop)
            {
                _ = Task.Run(async () => await InitLocalCameraServerAsync());
            }

            _ = Task.Run(async () =>
            {
                try
                {
                    var alb = GetCurrentStudentAlbum();
                    var grp = AppState.GroupCode;
                    await NoteService.SyncWithCloudAsync(FirebaseService, alb, grp, forceFullSync: true);
                    await InvokeAsync(() =>
                    {
                        RefreshHierarchy();
                        StateHasChanged();
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[Notes] Initial cloud sync error: {ex.Message}");
                }
            });

            cloudSyncTimer = new System.Timers.Timer(5000);
            cloudSyncTimer.AutoReset = true;
            cloudSyncTimer.Elapsed += (s, e) =>
            {
                _ = Task.Run(async () =>
                {
                    try
                    {
                        var alb = GetCurrentStudentAlbum();
                        var grp = AppState.GroupCode;
                        if (!string.IsNullOrWhiteSpace(alb) || !string.IsNullOrWhiteSpace(grp))
                        {
                            await NoteService.SyncWithCloudAsync(FirebaseService, alb, grp);
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[Notes] Background cloud sync error: {ex.Message}");
                    }
                });
            };
            cloudSyncTimer.Start();
        }

        if (activeNote != null)
        {
            try
            {
                if (!isJsInitialized)
                {
                    await JS.InvokeVoidAsync("notesEditor.init", editorElementRef, dotNetHelper, activeNote.Id.ToString());
                    isJsInitialized = true;
                    lastLoadedNoteId = activeNote.Id;
                    await UpdateEditorContentAsync();
                }
                else if (lastLoadedNoteId != activeNote.Id)
                {
                    lastLoadedNoteId = activeNote.Id;
                    await UpdateEditorContentAsync();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Notes] JS Init/SetContent error: {ex.Message}");
            }
        }
    }

    private void RefreshHierarchy()
    {
        var scheduleData = ScheduleService.GetPreparedData();
        folderHierarchy = NoteService.BuildFolderHierarchy(scheduleData);
    }

    private void SelectInitialFolder()
    {
        if (selectedFolder == null)
        {
            selectedFolder = folderHierarchy.FirstOrDefault(f => f.FolderType == NoteFolderType.All);
        }
        else
        {
            selectedFolder = FindNodeById(folderHierarchy, selectedFolder.Id) ?? folderHierarchy.FirstOrDefault();
        }

        if (AppState.PendingOpenNoteId.HasValue)
        {
            var pendingId = AppState.PendingOpenNoteId.Value;
            AppState.PendingOpenNoteId = null;
            var targetNote = NoteService.GetAllNotes().FirstOrDefault(n => n.Id == pendingId);
            if (targetNote != null)
            {
                selectedFolder = folderHierarchy.FirstOrDefault(f => f.FolderType == NoteFolderType.All) ?? selectedFolder;
                activeNote = targetNote;
                mobileDepth = 2;
                return;
            }
        }

        var firstNote = FilteredNotes.FirstOrDefault();
        if (activeNote == null && firstNote != null)
        {
            activeNote = firstNote;
        }
    }

    private NoteFolderNode? FindNodeById(IEnumerable<NoteFolderNode> nodes, string id)
    {
        foreach (var node in nodes)
        {
            if (node.Id == id) return node;
            var found = FindNodeById(node.Children, id);
            if (found != null) return found;
        }
        return null;
    }

    private void SelectFolder(NoteFolderNode folder)
    {
        selectedFolder = folder;
        mobileDepth = 1;

        if (activeNote != null && !FilteredNotes.Any(n => n.Id == activeNote.Id))
        {
            activeNote = FilteredNotes.FirstOrDefault();
            _ = UpdateEditorContentAsync();
        }
    }

    private void ToggleFolderExpanded(NoteFolderNode node)
    {
        node.IsExpanded = !node.IsExpanded;
    }

    private void SelectNote(Note note)
    {
        if (activeNote?.Id != note.Id)
        {
            if (_titleDebounceCts != null)
            {
                _titleDebounceCts.Cancel();
                _titleDebounceCts.Dispose();
                _titleDebounceCts = null;
                if (activeNote != null && CanModifyNote(activeNote) && !activeNote.IsDeleted)
                {
                    _ = NoteService.SaveNoteAsync(activeNote);
                }
            }

            activeNote = note;
            lastLoadedNoteId = null;
            _ = UpdateEditorContentAsync();
            _ = LoadThumbnailsForActiveNoteAsync();
            _ = BroadcastCameraStateAsync();
        }
        mobileDepth = 2;
    }

    private async Task UpdateEditorContentAsync()
    {
        if (activeNote != null && isJsInitialized)
        {
            try
            {
                lastLoadedNoteId = activeNote.Id;
                var displayHtml = await PrepareContentForEditorAsync(activeNote);
                await JS.InvokeVoidAsync("notesEditor.setContent", editorElementRef, displayHtml, activeNote.Id.ToString());
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Notes] UpdateEditorContentAsync error: {ex.Message}");
            }
        }
    }

    private async Task<string> PrepareContentForEditorAsync(Note note)
    {
        if (string.IsNullOrWhiteSpace(note.Content)) return "";

        // Lazy-loading załączników z chmury na żądanie (gdy nie ma ich jeszcze lokalnie na dysku)
        if (note.Attachments != null && note.Attachments.Any(a => string.IsNullOrEmpty(a.LocalPath) || !File.Exists(a.LocalPath)))
        {
            await NoteService.EnsureNoteAttachmentsLoadedFromCloudAsync(note, FirebaseService, GetCurrentStudentAlbum(), AppState.GroupCode);
        }

        if (!note.Content.Contains("data-attachment-id", StringComparison.OrdinalIgnoreCase)) return note.Content;

        var html = note.Content;
        var attachmentsDir = NoteService.GetAttachmentsDirectory();

        // Krok 1: Wykryj wszystkie atrybuty data-attachment-id obecne w treści HTML
        var regex = new System.Text.RegularExpressions.Regex(@"data-attachment-id=[""']([a-zA-Z0-9_\-]+)[""']", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        var matches = regex.Matches(html);

        var noteAttachments = note.Attachments ?? new List<NoteAttachment>();
        bool noteModified = false;

        foreach (System.Text.RegularExpressions.Match match in matches)
        {
            var attId = match.Groups[1].Value;
            if (string.IsNullOrWhiteSpace(attId)) continue;

            // Szukaj załącznika na liście notatki
            var att = noteAttachments.FirstOrDefault(a => string.Equals(a.Id, attId, StringComparison.OrdinalIgnoreCase));

            // Self-healing: Jeśli załącznika brakuje w liście notatki, przeszukaj dysk w poszukiwaniu pliku
            if (att == null)
            {
                var candidateFiles = Directory.Exists(attachmentsDir) ? Directory.GetFiles(attachmentsDir, $"*{attId}*") : Array.Empty<string>();
                var candidate = candidateFiles.FirstOrDefault(f => !f.EndsWith("_thumb.jpg", StringComparison.OrdinalIgnoreCase)) ?? candidateFiles.FirstOrDefault();

                if (!string.IsNullOrEmpty(candidate) && File.Exists(candidate))
                {
                    att = new NoteAttachment
                    {
                        Id = attId,
                        FileName = Path.GetFileName(candidate),
                        ContentType = candidate.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ? "image/png" : "image/jpeg",
                        LocalPath = candidate,
                        ThumbnailPath = candidateFiles.FirstOrDefault(f => f.EndsWith("_thumb.jpg", StringComparison.OrdinalIgnoreCase)) ?? candidate,
                        SizeBytes = new FileInfo(candidate).Length,
                        UploadedAt = File.GetCreationTimeUtc(candidate)
                    };

                    noteAttachments.Add(att);
                    noteModified = true;
                }
            }

            // Pobierz Data URI dla tego obrazu
            string uri = "";
            if (att != null)
            {
                if (_thumbnailCache.TryGetValue(att.Id, out var cached) && !string.IsNullOrEmpty(cached))
                {
                    uri = cached;
                }
                else
                {
                    var path = !string.IsNullOrEmpty(att.ThumbnailPath) && File.Exists(att.ThumbnailPath)
                        ? att.ThumbnailPath
                        : att.LocalPath;

                    // Fallback jeśli path na dysku ma inną ścieżkę bazową (np. po przeniesieniu sandboxa)
                    if (string.IsNullOrEmpty(path) || !File.Exists(path))
                    {
                        var candidateFiles = Directory.Exists(attachmentsDir) ? Directory.GetFiles(attachmentsDir, $"*{attId}*") : Array.Empty<string>();
                        path = candidateFiles.FirstOrDefault(f => !f.EndsWith("_thumb.jpg", StringComparison.OrdinalIgnoreCase)) ?? candidateFiles.FirstOrDefault();
                    }

                    if (!string.IsNullOrEmpty(path) && File.Exists(path))
                    {
                        uri = await NoteService.GetAttachmentDataUriAsync(path, att.ContentType);
                        if (!string.IsNullOrEmpty(uri))
                        {
                            _thumbnailCache[att.Id] = uri;
                        }
                    }
                }
            }

            if (!string.IsNullOrEmpty(uri))
            {
                var pattern = $@"<img([^>]*\bdata-attachment-id=[""']{attId}[""'][^>]*)>";
                html = System.Text.RegularExpressions.Regex.Replace(html, pattern, m =>
                {
                    var tag = m.Value;
                    if (!tag.Contains("src=", StringComparison.OrdinalIgnoreCase))
                    {
                        return tag.Insert(4, $" src=\"{uri}\"");
                    }
                    return System.Text.RegularExpressions.Regex.Replace(tag, @"src=""[^""]*""", $"src=\"{uri}\"");
                }, System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            }
        }

        if (noteModified)
        {
            note.Attachments = noteAttachments;
            await NoteService.SaveNoteAsync(note);
        }

        return html;
    }

