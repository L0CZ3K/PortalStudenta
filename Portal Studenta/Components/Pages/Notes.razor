    private async Task CaptureWhiteboardPhotoAsync()
    {
        if (activeNote == null) return;
        try
        {
            FileResult? photo = null;

            // On macOS (MacCatalyst) or Desktop idiom:
            // MediaPicker.CapturePhotoAsync is NOT supported by macOS UI, causing freezes or inability to cancel.
            // Always use native FilePicker on MacCatalyst/Desktop.
            if (DeviceInfo.Current.Platform == DevicePlatform.MacCatalyst || DeviceInfo.Current.Idiom == DeviceIdiom.Desktop)
            {
                photo = await FilePicker.Default.PickAsync(new PickOptions
                {
                    PickerTitle = CurrentLang == "en-US" ? "Select whiteboard photo" : "Wybierz zdjęcie tablicy",
                    FileTypes = FilePickerFileType.Images
                });
            }
            else
            {
                // Mobile platforms (iOS / Android) — muszą być wywołane na MainThread dla UIKit
                photo = await MainThread.InvokeOnMainThreadAsync(async () =>
                {
                    var status = await Permissions.CheckStatusAsync<Permissions.Camera>();
                    if (status != PermissionStatus.Granted)
                    {
                        status = await Permissions.RequestAsync<Permissions.Camera>();
                    }

                    if (status == PermissionStatus.Granted && MediaPicker.Default.IsCaptureSupported)
                    {
                        return await MediaPicker.Default.CapturePhotoAsync();
                    }

                    if (status != PermissionStatus.Granted)
                    {
                        bool openSettings = false;
                        if (Application.Current?.Windows.FirstOrDefault()?.Page != null)
                        {
                            openSettings = await Application.Current.Windows[0].Page!.DisplayAlertAsync(
                                CurrentLang == "en-US" ? "Camera Access Required" : "Dostęp do aparatu",
                                CurrentLang == "en-US"
                                    ? "UniAvio needs camera access to take whiteboard photos. Please enable Camera in iOS Settings -> UniAvio."
                                    : "UniAvio potrzebuje dostępu do aparatu, aby robić zdjęcia tablicy. Włącz aparat w Ustawienia -> UniAvio -> Aparat.",
                                CurrentLang == "en-US" ? "Open Settings" : "Otwórz Ustawienia",
                                CurrentLang == "en-US" ? "Use Gallery" : "Użyj galerii"
                            );
                        }

                        if (openSettings)
                        {
                            AppInfo.Current.ShowSettingsUI();
                            return null;
                        }

                        return await PickSinglePhotoAsync();
                    }

                    return await PickSinglePhotoAsync();
                });
            }

            if (photo != null)
            {
                string? dataUri = null;
                string? attachmentId = null;
                var fileName = photo.FileName;
                var contentType = photo.ContentType;

                byte[] photoBytes;
                using (var rawStream = await MainThread.InvokeOnMainThreadAsync(async () => await photo.OpenReadAsync()))
                using (var ms = new MemoryStream())
                {
                    await rawStream.CopyToAsync(ms);
                    photoBytes = ms.ToArray();
                }

                await Task.Run(async () =>
                {
                    using var stream = new MemoryStream(photoBytes);
                    var savedAtt = await NoteService.AddAttachmentAsync(activeNote.Id, stream, fileName, contentType);
                    if (savedAtt != null && !string.IsNullOrEmpty(savedAtt.LocalPath))
                    {
                        attachmentId = savedAtt.Id;
                        dataUri = await NoteService.GetAttachmentDataUriAsync(savedAtt.LocalPath, savedAtt.ContentType);
                    }
                });

                if (!string.IsNullOrEmpty(dataUri) && !string.IsNullOrEmpty(attachmentId))
                {
                    await JS.InvokeVoidAsync("notesEditor.insertInlineImage", attachmentId, dataUri, fileName);
                }
                await LoadThumbnailsForActiveNoteAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or TaskCanceledException)
        {
            // Użytkownik anulował wybór zdjęcia (np. na Macu w Finderze) — czyste wyjście
            Console.WriteLine("[Notes] Photo picking cancelled by user.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Notes] CaptureWhiteboardPhoto error: {ex.Message}");
        }
    }

