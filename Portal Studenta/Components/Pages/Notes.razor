    private string GetCurrentStudentAlbum()
    {
        var album = Preferences.Default.Get("user_student_number", "");
        if (string.IsNullOrWhiteSpace(album)) album = Preferences.Default.Get("user_album", "");
        if (string.IsNullOrWhiteSpace(album)) album = "demo_student";
