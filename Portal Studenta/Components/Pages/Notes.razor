    private async Task DeleteActiveNote()
    {
        if (activeNote == null) return;
        if (activeNote.IsDeleted)
        {
            await PermanentDeleteActiveNoteAsync();
            return;
        }
        if (!CanModifyNote(activeNote)) return;

        var noteToTrash = activeNote;
        await NoteService.MoveToTrashAsync(noteToTrash.Id);

        var alb = GetCurrentStudentAlbum();
        var grp = AppState.GroupCode;
        _ = Task.Run(async () =>
        {
            try
            {
                if (!string.IsNullOrWhiteSpace(alb) && noteToTrash.SharingMode != NoteSharingMode.LocalOnly)
                    await FirebaseService.SyncNoteToCloudAsync(alb, noteToTrash);
                if (!string.IsNullOrWhiteSpace(grp) && noteToTrash.SharingMode == NoteSharingMode.SharedWithAll)
                    await FirebaseService.UnshareNoteFromGroupLobbyAsync(grp, noteToTrash.Id);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Notes] MoveToTrash cloud sync error: {ex.Message}");
            }
        });

        RefreshHierarchy();
        activeNote = FilteredNotes.FirstOrDefault();
        if (activeNote == null)
        {
            mobileDepth = 1;
        }
        else
        {
            _ = UpdateEditorContentAsync();
            _ = LoadThumbnailsForActiveNoteAsync();
        }
        StateHasChanged();
    }

