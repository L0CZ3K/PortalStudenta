    private static string GetCleanSnippet(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return "Brak dodatkowego tekstu";
        // Usuń tagi obrazów lub wstaw ikonę, aby tekst po zdjęciu nie został ucięty
        var stripped = System.Text.RegularExpressions.Regex.Replace(html, @"<img[^>]*>", " 🖼️ ", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        var truncated = stripped.Length > 500 ? stripped.Substring(0, 500) : stripped;
        var plain = System.Text.RegularExpressions.Regex.Replace(truncated, "<.*?>", " ");
        plain = System.Net.WebUtility.HtmlDecode(plain).Trim();
        if (string.IsNullOrWhiteSpace(plain)) return "Brak tekstu";
        return plain.Length > 70 ? plain.Substring(0, 70) + "…" : plain;
    }

    private static string FormatNoteDate(DateTime date)
    {
        var now = DateTime.Now;
        if (date.Date == now.Date) return date.ToString("HH:mm");
        if (date.Date == now.Date.AddDays(-1)) return "Wczoraj";
        if (date.Year == now.Year) return date.ToString("dd.MM");
        return date.ToString("dd.MM.yyyy");
    }

    private static string FormatShortBadge(string subject, string? type, string? group)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(subject))
        {
            var shortSubj = subject.Length > 12 ? subject.Substring(0, 10) + "…" : subject;
            parts.Add(shortSubj);
        }
        if (!string.IsNullOrWhiteSpace(type)) parts.Add(type);
        if (!string.IsNullOrWhiteSpace(group)) parts.Add(group);
        return string.Join(" • ", parts);
    }

    private void OnAppStateChanged()
    {
        CurrentLang = AppState.Language;
        if (AppState.PendingOpenNoteId.HasValue)
        {
            var pendingId = AppState.PendingOpenNoteId.Value;
            AppState.PendingOpenNoteId = null;
            var targetNote = NoteService.GetAllNotes().FirstOrDefault(n => n.Id == pendingId);
            if (targetNote != null)
            {
                selectedFolder = folderHierarchy.FirstOrDefault(f => f.FolderType == NoteFolderType.All) ?? selectedFolder;
                SelectNote(targetNote);
            }
        }
        InvokeAsync(StateHasChanged);
    }

    private void OnNotesServiceChanged()
    {
        InvokeAsync(async () =>
        {
            RefreshHierarchy();
            if (activeNote != null && !NoteService.GetAllNotes().Any(n => n.Id == activeNote.Id))
            {
                activeNote = FilteredNotes.FirstOrDefault();
                if (activeNote != null)
                {
                    await UpdateEditorContentAsync();
                    await LoadThumbnailsForActiveNoteAsync();
                }
                else
                {
                    if (isJsInitialized)
                    {
                        try { await JS.InvokeVoidAsync("notesEditor.setContent", editorElementRef, "", ""); }
                        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[Notes] Reset editor content: {ex.Message}"); }
                    }
                    mobileDepth = 1;
                }
            }
            StateHasChanged();
        });
    }

    private void OnScheduleServiceLoaded()
    {
        InvokeAsync(() =>
        {
            RefreshHierarchy();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AppState.OnChange -= OnAppStateChanged;
        NoteService.OnNotesChanged -= OnNotesServiceChanged;
        ScheduleService.OnScheduleLoaded -= OnScheduleServiceLoaded;
        dotNetHelper?.Dispose();

        _titleDebounceCts?.Cancel();
        _titleDebounceCts?.Dispose();
        _titleDebounceCts = null;

        _thumbnailCache.Clear();

        if (cloudSyncTimer != null)
        {
            cloudSyncTimer.Stop();
            cloudSyncTimer.Dispose();
            cloudSyncTimer = null;
        }

        if (cameraPollTimer != null)
        {
            cameraPollTimer.Stop();
            cameraPollTimer.Dispose();
            cameraPollTimer = null;
        }

        if (pcHeartbeatTimer != null)
        {
            pcHeartbeatTimer.Stop();
            pcHeartbeatTimer.Dispose();
            pcHeartbeatTimer = null;
        }

        if (phoneStatusPollTimer != null)
        {
            phoneStatusPollTimer.Stop();
            phoneStatusPollTimer.Dispose();
            phoneStatusPollTimer = null;
        }

        if (wifiServer != null)
        {
            wifiServer.OnPhotoReceived -= HandlePhotoReceivedFromPhoneAsync;
            wifiServer.Dispose();
            wifiServer = null;
        }

        if (IsDesktop)
        {
            var alb = GetCurrentStudentAlbum();
            _ = Task.Run(async () =>
            {
                try
                {
                    await FirebaseService.SetPermanentRemoteCameraOfflineAsync(alb);
                }
                catch (Exception ex)
                {
                    System.Diagnostics.Debug.WriteLine($"[Notes] SetPermanentRemoteCameraOfflineAsync error: {ex.Message}");
                }
            });
        }
    }
    
   
        // Sprawdza czy urządzenie to telefon
        private bool IsPhone => DeviceInfo.Current.Idiom == DeviceIdiom.Phone;
        // Albo czy to komputer (Desktop / MacCatalyst / Windows)
        private bool IsDesktop => DeviceInfo.Current.Idiom == DeviceIdiom.Desktop 
                                  || DeviceInfo.Current.Platform == DevicePlatform.MacCatalyst
                                  || DeviceInfo.Current.Platform == DevicePlatform.WinUI;
    
