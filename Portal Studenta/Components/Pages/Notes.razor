    private LocalNetworkCameraServer? wifiServer;
    private string remoteTargetNoteTitle = "";
    private string remoteTargetLocalEndpoint = "";
    private string remoteTargetAuthToken = "";

    private string GetCurrentStudentAlbum()
    {
        var album = Preferences.Default.Get("user_student_number", "");
        if (string.IsNullOrWhiteSpace(album)) album = Preferences.Default.Get("user_album", "");
        if (string.IsNullOrWhiteSpace(album)) album = "demo_student";
        return album;
    }

    private async Task InitLocalCameraServerAsync()
    {
        if (!IsDesktop || wifiServer != null) return;
        try
        {
            wifiServer = new LocalNetworkCameraServer();
            wifiServer.OnPhotoReceived += HandlePhotoReceivedFromPhoneAsync;
            var started = await wifiServer.StartAsync();
            if (started)
            {
                await BroadcastCameraStateAsync();

                pcHeartbeatTimer?.Stop();
                pcHeartbeatTimer?.Dispose();
                pcHeartbeatTimer = new System.Timers.Timer(8000);
                pcHeartbeatTimer.Elapsed += async (s, e) =>
                {
                    try
                    {
                        var alb = GetCurrentStudentAlbum();
                        await FirebaseService.UpdatePermanentRemoteCameraHeartbeatAsync(alb);
                    }
                    catch {}
                };
                pcHeartbeatTimer.AutoReset = true;
                pcHeartbeatTimer.Start();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Notes] InitLocalCameraServer error: {ex.Message}");
        }
    }

    private async Task BroadcastCameraStateAsync()
    {
        if (!IsDesktop) return;
        try
        {
            var album = GetCurrentStudentAlbum();
            var noteId = activeNote?.Id.ToString() ?? "";
            var noteTitle = activeNote?.Title ?? "Nowa notatka";
            var endpoint = wifiServer?.EndpointUrl;
            var authToken = wifiServer?.AuthToken;
            await FirebaseService.SetPermanentRemoteCameraReadyAsync(album, noteId, noteTitle, endpoint, authToken);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Notes] BroadcastCameraState error: {ex.Message}");
        }
    }

    private async Task HandlePhotoReceivedFromPhoneAsync(byte[] bytes, string contentType)
    {
        try
        {
            if (activeNote == null)
            {
                await InvokeAsync(CreateUncategorizedNote);
            }

            if (activeNote != null)
            {
                var fileName = $"tablica_{DateTime.Now:yyyyMMdd_HHmmss}.jpg";
                string? dataUri = null;
                string? attachmentId = null;

                await Task.Run(async () =>
                {
                    using var ms = new MemoryStream(bytes);
                    // Zdjęcie z telefonu zostało już zoptymalizowane — zapis bezpośredni w <1ms
                    var savedAtt = await NoteService.AddAttachmentAsync(activeNote.Id, ms, fileName, contentType, alreadyOptimized: true);
                    if (savedAtt != null)
                    {
                        attachmentId = savedAtt.Id;
                        var base64 = Convert.ToBase64String(bytes);
                        dataUri = $"data:{contentType};base64,{base64}";
                    }
                });

                if (!string.IsNullOrEmpty(dataUri) && !string.IsNullOrEmpty(attachmentId))
                {
                    await InvokeAsync(async () =>
                    {
                        await JS.InvokeVoidAsync("notesEditor.insertInlineImage", attachmentId, dataUri, fileName);
                        showRemoteCameraModal = false;
                        StateHasChanged();
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Notes] HandlePhotoReceived error: {ex.Message}");
        }
    }

    private async Task StartRemoteCameraSessionAsync()
    {
        if (activeNote == null) return;
        var album = GetCurrentStudentAlbum();

        await InitLocalCameraServerAsync();
        await BroadcastCameraStateAsync();

        showRemoteCameraModal = true;
        isCameraWaiting = true;

        cameraPollTimer?.Stop();
        cameraPollTimer?.Dispose();
        cameraPollTimer = new System.Timers.Timer(2000);
        cameraPollTimer.Elapsed += async (s, e) => await CheckRemoteCameraUploadAsync(album, FirebaseService.PermanentCameraSessionId);
        cameraPollTimer.AutoReset = true;
        cameraPollTimer.Start();
        StateHasChanged();
    }

    private async Task CheckRemoteCameraUploadAsync(string album, string sessionId)
    {
        try
        {
            var session = await FirebaseService.GetPermanentRemoteCameraSessionAsync(album);
            if (session != null && session.Status == "uploaded" && !string.IsNullOrWhiteSpace(session.PhotoDataBase64))
            {
                cameraPollTimer?.Stop();
                isCameraWaiting = false;

                var bytes = Convert.FromBase64String(session.PhotoDataBase64);
                await HandlePhotoReceivedFromPhoneAsync(bytes, session.ContentType ?? "image/jpeg");
                await BroadcastCameraStateAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Notes] Remote camera check error: {ex.Message}");
        }
    }

