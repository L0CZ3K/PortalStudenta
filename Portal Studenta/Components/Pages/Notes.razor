    [JSInvokable]
    public async Task OnEditorContentChanged(string noteId, string htmlContent)
    {
        if (activeNote != null && activeNote.Id.ToString() == noteId)
        {
            if (!CanModifyNote(activeNote) || activeNote.IsDeleted) return;
            activeNote.Content = htmlContent;

            // Zabezpieczenie: jeśli w serwisie są nowsze załączniki, nie nadpisuj ich przestarzałą listą
            var freshNote = NoteService.GetAllNotes().FirstOrDefault(n => n.Id == activeNote.Id);
            if (freshNote?.Attachments != null && freshNote.Attachments.Count > activeNote.Attachments.Count)
            {
                activeNote.Attachments = freshNote.Attachments;
            }

            await NoteService.SaveNoteAsync(activeNote);
            SyncNoteIfCloudEnabled(activeNote);
        }
        else if (Guid.TryParse(noteId, out var parsedId))
        {
            var note = NoteService.GetAllNotes().FirstOrDefault(n => n.Id == parsedId);
            if (note != null && CanModifyNote(note) && !note.IsDeleted)
            {
                note.Content = htmlContent;
                await NoteService.SaveNoteAsync(note);
                SyncNoteIfCloudEnabled(note);
            }
        }
    }

    [JSInvokable]
    public async Task OnClipboardImagePasted(string dataUriOrBase64, string contentType, string fileName)
    {
        if (activeNote == null || !CanModifyNote(activeNote) || activeNote.IsDeleted) return;
        try
        {
            var base64 = dataUriOrBase64;
            if (base64.Contains(",")) base64 = base64.Substring(base64.IndexOf(",") + 1);
            var bytes = Convert.FromBase64String(base64);

            string? dataUri = null;
            string? attachmentId = null;

            await Task.Run(async () =>
            {
                using var ms = new MemoryStream(bytes);
                var savedAtt = await NoteService.AddAttachmentAsync(activeNote.Id, ms, fileName, contentType);
                if (savedAtt != null && !string.IsNullOrEmpty(savedAtt.LocalPath))
                {
                    attachmentId = savedAtt.Id;
                    dataUri = await NoteService.GetAttachmentDataUriAsync(savedAtt.LocalPath, savedAtt.ContentType);
                    lock (activeNote)
                    {
                        var attList = activeNote.Attachments;
                        if (!attList.Any(a => a.Id == savedAtt.Id))
                        {
                            attList.Add(savedAtt);
                            activeNote.Attachments = attList;
                        }
                    }
                }
            });

            if (!string.IsNullOrEmpty(dataUri) && !string.IsNullOrEmpty(attachmentId))
            {
                await JS.InvokeVoidAsync("notesEditor.insertInlineImage", attachmentId, dataUri, fileName);
            }
            SyncNoteIfCloudEnabled(activeNote);
            await LoadThumbnailsForActiveNoteAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Notes] OnClipboardImagePasted error: {ex.Message}");
        }
    }

