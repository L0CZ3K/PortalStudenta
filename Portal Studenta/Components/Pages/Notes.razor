    private async Task OnAttachmentClick(NoteAttachment att, string? fallbackSrc = null)
    {
        try
        {
            var isImg = att.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) ||
                        att.FileName.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
                        att.FileName.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
                        att.FileName.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
                        att.FileName.EndsWith(".webp", StringComparison.OrdinalIgnoreCase) ||
                        att.FileName.EndsWith(".heic", StringComparison.OrdinalIgnoreCase);

            if (isImg)
            {
                activeLightboxAttachment = att;
                lightboxImageUri = "";
                await InvokeAsync(StateHasChanged);

                string uri = "";
                if (!string.IsNullOrEmpty(att.LocalPath) && File.Exists(att.LocalPath))
                {
                    uri = await NoteService.GetAttachmentDataUriAsync(att.LocalPath, att.ContentType);
                }

                if (string.IsNullOrEmpty(uri))
                {
                    var attachmentsDir = NoteService.GetAttachmentsDirectory();
                    var candidateFiles = Directory.Exists(attachmentsDir) ? Directory.GetFiles(attachmentsDir, $"*{att.Id}*") : Array.Empty<string>();
                    var candidate = candidateFiles.FirstOrDefault(f => !f.EndsWith("_thumb.jpg", StringComparison.OrdinalIgnoreCase)) ?? candidateFiles.FirstOrDefault();
                    if (!string.IsNullOrEmpty(candidate) && File.Exists(candidate))
                    {
                        att.LocalPath = candidate;
                        uri = await NoteService.GetAttachmentDataUriAsync(candidate, att.ContentType);
                    }
                }

                if (string.IsNullOrEmpty(uri))
                {
                    if (!string.IsNullOrEmpty(att.ThumbnailPath) && File.Exists(att.ThumbnailPath))
                    {
                        uri = await NoteService.GetAttachmentDataUriAsync(att.ThumbnailPath, "image/jpeg");
                    }
                    else if (_thumbnailCache.TryGetValue(att.Id, out var cachedUri) && !string.IsNullOrEmpty(cachedUri))
                    {
                        uri = cachedUri;
                    }
                    else if (!string.IsNullOrEmpty(fallbackSrc))
                    {
                        uri = fallbackSrc;
                    }
                }

                // Jeśli plik lokalny z jakiegoś powodu nie istniał, a mamy dane obrazu, przywróć go na dysk
                if ((string.IsNullOrEmpty(att.LocalPath) || !File.Exists(att.LocalPath)) &&
                    !string.IsNullOrEmpty(uri) && uri.StartsWith("data:image", StringComparison.OrdinalIgnoreCase))
                {
                    try
                    {
                        var restoredPath = await SaveDataUriToTempFileAsync(uri, att.FileName);
                        if (!string.IsNullOrEmpty(restoredPath) && File.Exists(restoredPath))
                        {
                            att.LocalPath = restoredPath;
                        }
                    }
                    catch { }
                }

                lightboxImageUri = uri;
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await OpenAttachmentInSystem(att);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Notes] OnAttachmentClick error: {ex.Message}");
        }
    }

