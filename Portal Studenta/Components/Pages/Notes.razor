                });
            }
            else
            {
                photo = await MainThread.InvokeOnMainThreadAsync(async () =>
                {
                    return await PickSinglePhotoAsync();
                });
            }

            if (photo == null)
            {
                isTransmittingPhoto = false;
                transmitStatusMessage = "Anulowano wybór zdjęcia.";
                return;
            }

            await ProcessAndUploadTransmittedPhotoAsync(photo);
        }
        catch (Exception ex) when (ex is OperationCanceledException or TaskCanceledException)
        {
            transmitStatusMessage = "Anulowano wybór zdjęcia.";
        }
        catch (Exception ex)
        {
            transmitStatusMessage = $"Błąd: {ex.Message}";
        }
        finally
        {
            isTransmittingPhoto = false;
            StateHasChanged();
        }
    }

    private async Task TransmitPhotoFromCurrentDeviceAsync()
    {
        try
        {
            isTransmittingPhoto = true;
            transmitStatusMessage = "Otwieranie aparatu...";

            FileResult? photo = null;

            if (DeviceInfo.Current.Platform == DevicePlatform.MacCatalyst || DeviceInfo.Current.Idiom == DeviceIdiom.Desktop)
            {
                photo = await FilePicker.Default.PickAsync(new PickOptions
                {
                    PickerTitle = CurrentLang == "en-US" ? "Select whiteboard photo to transmit" : "Wybierz zdjęcie tablicy do przesłania",
                    FileTypes = FilePickerFileType.Images
                });
            }
            else
            {
                photo = await MainThread.InvokeOnMainThreadAsync(async () =>
                {
                    var status = await Permissions.CheckStatusAsync<Permissions.Camera>();
                    if (status != PermissionStatus.Granted)
                    {
                        status = await Permissions.RequestAsync<Permissions.Camera>();
                    }

                    if (status == PermissionStatus.Granted && MediaPicker.Default.IsCaptureSupported)
                    {
                        isCameraPermissionDenied = false;
                        return await MediaPicker.Default.CapturePhotoAsync();
                    }

                    if (status != PermissionStatus.Granted)
                    {
                        isCameraPermissionDenied = true;
                        transmitStatusMessage = CurrentLang == "en-US"
                            ? "Camera permission denied. Tap 'Open Settings' below."
                            : "Brak uprawnień do aparatu. Kliknij poniżej, aby otworzyć Ustawienia.";
                        await InvokeAsync(StateHasChanged);
                        return null;
                    }

                    return await PickSinglePhotoAsync();
                });
            }

            if (photo == null)
            {
                isTransmittingPhoto = false;
                if (!isCameraPermissionDenied)
                {
                    transmitStatusMessage = "Anulowano robienie zdjęcia.";
                }
                return;
            }

            await ProcessAndUploadTransmittedPhotoAsync(photo);
        }
        catch (Exception ex) when (ex is OperationCanceledException or TaskCanceledException)
        {
            transmitStatusMessage = "Anulowano robienie zdjęcia.";
        }
        catch (Exception ex)
        {
            transmitStatusMessage = $"Błąd: {ex.Message}";
        }
        finally
        {
            isTransmittingPhoto = false;
            StateHasChanged();
        }
    }

    private async Task ProcessAndUploadTransmittedPhotoAsync(FileResult photo)
    {
        isTransmittingPhoto = true;
        transmitStatusMessage = "Przygotowywanie tablicy...";
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        var tempTarget = Path.Combine(Path.GetTempPath(), $"{Guid.NewGuid():N}.jpg");
        var tempThumb = Path.Combine(Path.GetTempPath(), $"{Guid.NewGuid():N}_thumb.jpg");

        try
        {
            // KROK 1: Bezpieczny odczyt bajtów na MainThread (na iOS odczyt strumienia z FileResult wymaga wątku UI)
            byte[] photoBytes;
            using (var rawStream = await MainThread.InvokeOnMainThreadAsync(async () => await photo.OpenReadAsync()))
            using (var ms = new MemoryStream())
            {
                await rawStream.CopyToAsync(ms);
                photoBytes = ms.ToArray();
            }

            await InvokeAsync(() =>
            {
                transmitStatusMessage = "Optymalizacja tablicy...";
                StateHasChanged();
            });

            // KROK 2: Sprzętowa optymalizacja tablicy (WhiteboardImageOptimizer)
            using (var inStream = new MemoryStream(photoBytes))
            {
                await WhiteboardImageOptimizer.OptimizeAndSaveAsync(inStream, tempTarget, tempThumb);
            }

            // KROK 3: Bezpieczne asynchroniczne przesyłanie sieciowe w tle (Task.Run)
            await Task.Run(async () =>
            {
                var bytes = await File.ReadAllBytesAsync(tempTarget);
                var base64 = Convert.ToBase64String(bytes);

                // Krok 3a: Próba przesłania bezpośrednio przez Wi-Fi (jeśli w jednej sieci)
                if (!string.IsNullOrEmpty(remoteTargetLocalEndpoint) && isTargetPcOnline && targetPcConnectionMode == "wifi")
                {
                    await InvokeAsync(() =>
                    {
                        transmitStatusMessage = "⚡ Błyskawiczne przesyłanie przez Wi-Fi...";
                        StateHasChanged();
                    });

                    var wifiSuccess = await LocalNetworkCameraServer.SendPhotoOverWifiAsync(remoteTargetLocalEndpoint, base64, "image/jpeg", remoteTargetAuthToken);
                    if (wifiSuccess)
                    {
                        await InvokeAsync(() =>
                        {
                            transmitStatusMessage = "Przesłano błyskawicznie przez Wi-Fi! ✓";
                            StateHasChanged();
                        });
                        await Task.Delay(800);
                        await InvokeAsync(() =>
                        {
                            showPhoneTransmitModal = false;
                            StateHasChanged();
                        });
                        return;
                    }
                }

                // Krok 3b: Fallback na stałą sesję w chmurze Firebase (jeśli Wi-Fi P2P niedostępne)
                await InvokeAsync(() =>
                {
                    transmitStatusMessage = "☁️ Przesyłanie przez chmurę...";
                    StateHasChanged();
                });

                var album = GetCurrentStudentAlbum();
                var success = await FirebaseService.UploadRemoteCameraPhotoAsync(album, FirebaseService.PermanentCameraSessionId, base64, "image/jpeg");

                if (success)
                {
                    await InvokeAsync(() =>
                    {
                        transmitStatusMessage = "Zdjęcie pomyślnie wysłane do komputera! ✓";
                        StateHasChanged();
                    });
                    await Task.Delay(800);
                    await InvokeAsync(() =>
                    {
                        showPhoneTransmitModal = false;
                        StateHasChanged();
                    });
                }
                else
                {
                    await InvokeAsync(() =>
                    {
                        transmitStatusMessage = "Błąd wysyłania: Upewnij się, że komputer ma otwartą aplikację.";
                        StateHasChanged();
                    });
                }
            });
        }
        catch (Exception ex)
        {
            transmitStatusMessage = $"Błąd przesyłania: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            try { if (File.Exists(tempTarget)) File.Delete(tempTarget); } catch {}
            try { if (File.Exists(tempThumb)) File.Delete(tempThumb); } catch {}
            isTransmittingPhoto = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task OnInlineImageClicked(string imageRef)
    {
        if (activeNote?.Attachments != null && activeNote.Attachments.Count > 0)
        {
            var matchedAtt = activeNote.Attachments.FirstOrDefault(a => a.Id == imageRef);
            if (matchedAtt != null)
            {
                await OnAttachmentClick(matchedAtt);
                return;
            }
        }

        lightboxImageUri = imageRef;
        activeLightboxAttachment = new NoteAttachment
        {
            FileName = "Zdjęcie w tekście",
            ContentType = "image/jpeg"
        };
        StateHasChanged();
    }

