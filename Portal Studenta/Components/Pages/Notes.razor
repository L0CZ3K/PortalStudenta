    private async Task OpenPhoneTransmitModal()
    {
        isCheckingPcStatus = true;
        isTargetPcOnline = false;
        targetPcConnectionMode = "offline";
        isCameraPermissionDenied = false;
        isTransmittingPhoto = false;
        transmitStatusMessage = "";
        showPhoneTransmitModal = true;
        StateHasChanged();

        try
        {
            var album = GetCurrentStudentAlbum();
            var session = await FirebaseService.GetPermanentRemoteCameraSessionAsync(album);

            if (session == null || session.Status == "offline")
            {
                isTargetPcOnline = false;
                targetPcConnectionMode = "offline";
                remoteTargetNoteTitle = "";
                remoteTargetLocalEndpoint = "";
                remoteTargetAuthToken = "";
            }
            else
            {
                remoteTargetNoteTitle = !string.IsNullOrWhiteSpace(session.NoteTitle) ? session.NoteTitle : "Aktywna notatka na PC";
                remoteTargetLocalEndpoint = session.LocalEndpoint ?? "";
                remoteTargetAuthToken = session.AuthToken ?? "";

                // Sprawdź czy heartbeat z Firebase nie jest przestarzały (np. Mac uśpiony/wyłączony > 25 sekund)
                var isHeartbeatFresh = (DateTime.UtcNow - session.UpdatedAt) <= TimeSpan.FromSeconds(25);

                // 1. Jeśli mamy endpoint Wi-Fi, wykonaj szybki ping (700ms)
                bool wifiAlive = false;
                if (!string.IsNullOrEmpty(remoteTargetLocalEndpoint))
                {
                    wifiAlive = await LocalNetworkCameraServer.PingAsync(remoteTargetLocalEndpoint);
                }

                if (wifiAlive)
                {
                    isTargetPcOnline = true;
                    targetPcConnectionMode = "wifi";
                }
                else if (isHeartbeatFresh && session.Status == "ready")
                {
                    // Wi-Fi nie odpowiedziało (np. izolacja AP na uczelni), ale Mac żyje w chmurze
                    isTargetPcOnline = true;
                    targetPcConnectionMode = "cloud";
                }
                else
                {
                    isTargetPcOnline = false;
                    targetPcConnectionMode = "offline";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Notes] OpenPhoneTransmitModal error: {ex.Message}");
            isTargetPcOnline = false;
            targetPcConnectionMode = "offline";
        }
        finally
        {
            isCheckingPcStatus = false;
            StateHasChanged();
        }
    }

    private void ClosePhoneTransmitModal()
    {
        showPhoneTransmitModal = false;
        StateHasChanged();
    }

    private async Task PickAndTransmitFromGalleryAsync()
    {
