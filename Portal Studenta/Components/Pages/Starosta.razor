    // --- ZARZĄDZANIE KODEM POKOJU (STAROSTA) ---
    private void GenerateRandomCode()
    {
        var random = new Random();
        const string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
        newGroupCodeInput = new string(Enumerable.Repeat(chars, 6).Select(s => s[random.Next(s.Length)]).ToArray());
    }

    private bool isChangingGroupCode = false;

    private async Task ChangeGroupCode()
    {
        if (!AppState.IsStarosta || isChangingGroupCode) return;
        if (string.IsNullOrWhiteSpace(newGroupCodeInput) || newGroupCodeInput.Trim().Length < 5)
        {
            Layout?.ShowToast(CurrentLang == "en-US" ? "New room code must have at least 5 characters!" : "Nowy kod pokoju musi mieć co najmniej 5 znaków!", MainLayout.ToastType.Warning);
            return;
        }

        string targetCode = newGroupCodeInput.Trim().ToUpper();
        string currentCode = AppState.GroupCode;

        if (targetCode.Equals(currentCode, StringComparison.OrdinalIgnoreCase))
        {
            Layout?.ShowToast(CurrentLang == "en-US" ? "This is your current room code!" : "To jest Twój obecny kod pokoju!", MainLayout.ToastType.Info);
            return;
        }

        isChangingGroupCode = true;
        try
        {
            var result = await FirebaseService.ChangeGroupCodeAsync(currentCode, targetCode);
            if (result == FirebaseService.ChangeGroupResult.Success)
            {
                HapticHelper.TriggerSuccess();
                AppState.SetGroupCode(targetCode);
                newGroupCodeInput = "";
                Layout?.ShowToast(CurrentLang == "en-US" 
                    ? $"Room code changed to {targetCode}! Lobby redirect active for members." 
                    : $"Kod pokoju zmieniony na {targetCode}! Lobby automatycznie przekierowuje studentów.", 
                    MainLayout.ToastType.Success);
            }
            else if (result == FirebaseService.ChangeGroupResult.AlreadyExists)
            {
                Layout?.ShowToast(CurrentLang == "en-US" 
                    ? $"Lobby ID '{targetCode}' is already taken by another group! Choose a different ID." 
                    : $"Kod pokoju (ID lobby) '{targetCode}' jest już zajęty przez inną grupę! Wybierz inny identyfikator.", 
                    MainLayout.ToastType.Warning);
            }
            else
            {
                Layout?.ShowToast(CurrentLang == "en-US" ? "Failed to change room code." : "Nie udało się zmienić kodu pokoju.", MainLayout.ToastType.Error);
            }
        }
        finally
        {
            isChangingGroupCode = false;
        }
    }

    // --- MODERACJA ADMINÓW (STAROSTA) ---
    private async Task LoadGroupRolesAsync()
    {
        if (!AppState.HasManagementPrivileges || string.IsNullOrEmpty(AppState.GroupCode)) return;

        try
        {
            var group = await FirebaseService.GetGroupAsync(AppState.GroupCode);
            if (group != null)
            {
                GroupStarostas = group.Starostas ?? new List<string>();
                var rawAdmins = group.Admins ?? new List<string>();
                GroupAdmins = rawAdmins.Where(a => !string.Equals(a, group.OwnerId, StringComparison.OrdinalIgnoreCase) && !GroupStarostas.Contains(a, StringComparer.OrdinalIgnoreCase)).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Starosta] Błąd pobierania ról grupy: {ex.Message}");
        }
    }

    private async Task AddAdmin()
    {
        if (!AppState.IsStarosta) return;
        if (string.IsNullOrWhiteSpace(newAdminAlbum))
        {
            Layout?.ShowToast(CurrentLang == "en-US" ? "Enter student album number!" : "Wpisz numer albumu studenta!", MainLayout.ToastType.Warning);
            return;
        }

        string album = newAdminAlbum.Trim();
        if (GroupAdmins.Contains(album))
        {
            Layout?.ShowToast(CurrentLang == "en-US" ? "Student is already an Administrator!" : "Ten student jest już Administratorem!", MainLayout.ToastType.Info);
            return;
        }

        bool success = await FirebaseService.AddGroupAdminAsync(AppState.GroupCode, album);
        if (success)
        {
            HapticHelper.TriggerSuccess();
            GroupAdmins.Add(album);
            newAdminAlbum = "";
            Layout?.ShowToast(CurrentLang == "en-US" ? $"Student {album} granted Admin role!" : $"Student {album} mianowany Administratorem!", MainLayout.ToastType.Success);
        }
        else
        {
            Layout?.ShowToast(CurrentLang == "en-US" ? "Failed to update Admin role." : "Nie udało się zapisać roli Admina.", MainLayout.ToastType.Error);
        }
    }

    private async Task RemoveAdmin(string album)
    {
        if (!AppState.IsStarosta) return;
        bool success = await FirebaseService.RemoveGroupAdminAsync(AppState.GroupCode, album);
        if (success)
        {
            HapticHelper.TriggerWarning();
            GroupAdmins.Remove(album);
            Layout?.ShowToast(CurrentLang == "en-US" ? $"Removed Admin privileges for {album}." : $"Odebrano uprawnienia Admina dla {album}.", MainLayout.ToastType.Warning);
        }
    }

    // --- ANKIETY (POLLS) ---
    private void EnsurePollsSubscription()
    {
        if (!AppState.HasManagementPrivileges || string.IsNullOrEmpty(AppState.GroupCode)) return;
        try
        {
            _pollsTimer?.Stop();
            _pollsTimer?.Dispose();
            _pollsTimer = new System.Timers.Timer(15000);
            _pollsTimer.Elapsed += (s, e) =>
            {
                InvokeAsync(async () =>
                {
                    try
                    {
                        await LoadPollsAsync();
                        StateHasChanged();
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[Starosta] Błąd timera ankiet: {ex.Message}");
                    }
                });
            };
            _pollsTimer.AutoReset = true;
            _pollsTimer.Start();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Starosta] Błąd konfiguracji timera ankiet: {ex.Message}");
        }
    }

    private async Task LoadPollsAsync()
    {
        if (!AppState.HasManagementPrivileges || string.IsNullOrEmpty(AppState.GroupCode)) return;
        try
        {
            GroupPolls = await FirebaseService.GetGroupPollsAsync(AppState.GroupCode);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Starosta] Błąd LoadPollsAsync: {ex.Message}");
        }
    }

    private void AddPollOption()
    {
        if (newPollOptions.Count < 6) newPollOptions.Add("");
    }

    private void RemovePollOption(int idx)
    {
        if (newPollOptions.Count > 2 && idx >= 0 && idx < newPollOptions.Count)
        {
            newPollOptions.RemoveAt(idx);
        }
    }

    private async Task CreatePollAsync()
    {
        if (!AppState.HasManagementPrivileges || isSubmittingPoll) return;
        if (string.IsNullOrWhiteSpace(newPollQuestion))
        {
            Layout?.ShowToast(CurrentLang == "en-US" ? "Enter poll question!" : "Wpisz pytanie ankiety!", MainLayout.ToastType.Warning);
            return;
        }

        var validOptions = newPollOptions.Where(o => !string.IsNullOrWhiteSpace(o)).Select(o => o.Trim()).ToList();
        if (validOptions.Count < 2)
        {
            Layout?.ShowToast(CurrentLang == "en-US" ? "Please provide at least 2 non-empty options!" : "Podaj co najmniej 2 warianty odpowiedzi!", MainLayout.ToastType.Warning);
            return;
        }

        isSubmittingPoll = true;
        try
        {
            var poll = new GroupPoll
            {
                Id = Guid.NewGuid().ToString("N"),
                GroupCode = AppState.GroupCode,
                Question = newPollQuestion.Trim(),
                Options = validOptions,
                CreatedBy = AppState.IsStarosta ? "Starosta" : "Admin",
                CreatedAt = DateTime.UtcNow
            };

            bool success = await FirebaseService.CreateGroupPollAsync(AppState.GroupCode, poll);
            if (success)
            {
                HapticHelper.TriggerSuccess();
                Layout?.ShowToast(CurrentLang == "en-US" ? "Poll published to group!" : "Ankieta została opublikowana!", MainLayout.ToastType.Success);
                newPollQuestion = "";
                newPollOptions = new() { "", "" };
                isCreatingPoll = false;
                await LoadPollsAsync();
            }
            else
            {
                Layout?.ShowToast(CurrentLang == "en-US" ? "Failed to publish poll." : "Nie udało się opublikować ankiety.", MainLayout.ToastType.Error);
            }
        }
        finally
        {
            isSubmittingPoll = false;
            StateHasChanged();
        }
    }

    private async Task ClosePollAsync(string pollId)
    {
        if (!AppState.HasManagementPrivileges) return;
        bool success = await FirebaseService.CloseGroupPollAsync(AppState.GroupCode, pollId);
        if (success)
        {
            HapticHelper.TriggerClick();
            Layout?.ShowToast(CurrentLang == "en-US" ? "Poll closed." : "Ankieta została zakończona.", MainLayout.ToastType.Info);
            await LoadPollsAsync();
            StateHasChanged();
        }
    }

    private async Task DeletePollAsync(string pollId)
    {
        if (!AppState.HasManagementPrivileges) return;
        bool success = await FirebaseService.DeleteGroupPollAsync(AppState.GroupCode, pollId);
        if (success)
        {
            HapticHelper.TriggerWarning();
            Layout?.ShowToast(CurrentLang == "en-US" ? "Poll deleted." : "Ankieta została usunięta.", MainLayout.ToastType.Warning);
            await LoadPollsAsync();
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _pollsTimer?.Stop();
        _pollsTimer?.Dispose();
        _pollsTimer = null;
        AppState.OnChange -= OnAppStateChanged;
        ScheduleService.OnScheduleLoaded -= OnScheduleDataChanged;
    }
