        var lesson = ScheduleService.GetPreparedData().Concat(ScheduleService.CustomEvents)
            .FirstOrDefault(l => ScheduleService.GetLessonKey(l) == ScheduleService.GetLessonKey(selectedLesson));

        if (lesson != null)
