<Router AppAssembly="typeof(MauiProgram).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <ErrorBoundary>
            <ChildContent>
                <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            </ChildContent>
            <ErrorContent Context="ex">
                <div style="padding: 24px; color: #ff453a; font-family: -apple-system, BlinkMacSystemFont, sans-serif; background: #000000; min-height: 100vh; box-sizing: border-box;">
                    <h2 style="margin-top: 0; color: #ffffff;">Wystąpił błąd widoku</h2>
                    <p style="color: #aeaeb2;">Aplikacja napotkała nieoczekiwany problem:</p>
                    <pre style="background: rgba(255,255,255,0.06); color: #ff453a; padding: 12px; border-radius: 8px; font-size: 12px; white-space: pre-wrap; word-break: break-all;">@ex.ToString()</pre>
                    <button style="margin-top: 16px; padding: 10px 20px; border-radius: 8px; background: #0071e3; color: white; border: none; font-weight: 600; cursor: pointer;" onclick="location.reload()">
                        Odśwież aplikację
                    </button>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </Found>
</Router>
